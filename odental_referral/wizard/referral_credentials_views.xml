<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_referral_credentials_wizard_form" model="ir.ui.view">
        <field name="name">odental.referral.credentials.wizard.form</field>
        <field name="model">odental.referral.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="Acceso temporal creado">
                <group>
                    <field name="referral_id"/>
                    <field name="credential_purpose"/>
                    <field name="access_url" widget="CopyClipboardChar"/>
                    <field name="one_time_code" widget="CopyClipboardChar"/>
                    <field name="expires_at"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="credential_purpose != 'patient'">
                    Envíe estas credenciales al paciente o representante para que revise y firme digitalmente el consentimiento. Comparta el enlace y el código por canales separados.
                </div>
                <div class="alert alert-warning" role="alert" invisible="credential_purpose != 'recipient'">
                    Envíe el enlace y el código por canales separados. O Dental conserva únicamente sus huellas digitales; estas credenciales no volverán a mostrarse.
                </div>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
