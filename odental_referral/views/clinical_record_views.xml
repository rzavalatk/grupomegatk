<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_clinical_record_form_referral" model="ir.ui.view">
        <field name="name">odental.clinical.record.form.referral</field>
        <field name="model">odental.clinical.record</field>
        <field name="inherit_id" ref="odental_clinical.view_odental_clinical_record_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Referencias">
                    <field name="referral_ids" context="{'default_clinical_record_id': id}">
                        <list decoration-success="state == 'active'" decoration-muted="state in ('closed', 'revoked', 'rejected', 'expired')">
                            <field name="name"/>
                            <field name="recipient_name"/>
                            <field name="referral_reason"/>
                            <field name="expires_at"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
