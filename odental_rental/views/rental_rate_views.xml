<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_rate_list" model="ir.ui.view"><field name="name">odental.rental.rate.list</field><field name="model">odental.rental.rate</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="organization_id"/><field name="resource_id" optional="show"/><field name="category_id" optional="show"/><field name="billing_basis"/><field name="price"/><field name="currency_id" column_invisible="1"/><field name="active"/></list></field></record>
    <record id="view_rental_rate_form" model="ir.ui.view"><field name="name">odental.rental.rate.form</field><field name="model">odental.rental.rate</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="organization_id"/><field name="resource_id" domain="[('organization_id', '=', organization_id), ('is_rentable', '=', True)]"/><field name="category_id" domain="[('organization_id', '=', organization_id)]"/></group><group><field name="billing_basis"/><field name="price"/><field name="currency_id" invisible="1"/><field name="product_id"/><field name="active"/></group></group><group string="Reglas de cobro"><field name="included_minutes" invisible="billing_basis not in ('half_day', 'day')"/><field name="minimum_minutes" invisible="billing_basis != 'hour'"/><field name="increment_minutes" invisible="billing_basis != 'hour'"/><field name="overage_price_per_hour" invisible="billing_basis == 'patient'"/><field name="sequence"/></group></sheet></form></field></record>
    <record id="action_rental_rate" model="ir.actions.act_window"><field name="name">Tarifas de alquiler</field><field name="res_model">odental.rental.rate</field><field name="view_mode">list,form</field></record>
</odoo>

