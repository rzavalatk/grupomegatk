<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_booking_list" model="ir.ui.view"><field name="name">odental.rental.booking.list</field><field name="model">odental.rental.booking</field><field name="arch" type="xml"><list decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="start_datetime"/><field name="professional_id"/><field name="provider_organization_id"/><field name="renter_organization_id"/><field name="amount_total"/><field name="currency_id" column_invisible="1"/><field name="state"/></list></field></record>
    <record id="view_rental_booking_calendar" model="ir.ui.view"><field name="name">odental.rental.booking.calendar</field><field name="model">odental.rental.booking</field><field name="arch" type="xml"><calendar string="Reservas de espacios" date_start="start_datetime" date_stop="end_datetime" color="professional_id"><field name="name"/><field name="professional_id"/><field name="provider_organization_id"/><field name="state"/></calendar></field></record>
    <record id="view_rental_booking_form" model="ir.ui.view"><field name="name">odental.rental.booking.form</field><field name="model">odental.rental.booking</field><field name="arch" type="xml"><form><header><button name="action_sync_resources" type="object" string="Actualizar recursos" invisible="state not in ('draft', 'reserved')"/><button name="action_reserve" type="object" string="Confirmar reserva" class="btn-primary" invisible="state != 'draft'"/><button name="action_start" type="object" string="Iniciar uso" invisible="state != 'reserved'"/><button name="action_complete" type="object" string="Liquidar uso" class="btn-primary" invisible="state not in ('reserved', 'in_progress')"/><button name="action_create_quotation" type="object" string="Cotizar cargos" invisible="state != 'completed' or sale_order_id or amount_total == 0"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('completed', 'cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,reserved,in_progress,completed"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_quotation" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not sale_order_id"><field name="sale_order_id" string="Cotización" widget="statinfo"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="appointment_id"/><field name="professional_id"/><field name="renter_organization_id"/></group><group><field name="provider_organization_id"/><field name="start_datetime"/><field name="end_datetime"/><field name="actual_start" readonly="state in ('completed', 'cancelled')"/><field name="actual_end" readonly="state in ('completed', 'cancelled')"/></group></group><field name="line_ids" readonly="state in ('in_progress', 'completed', 'cancelled')"><list><field name="resource_id"/><field name="rate_id"/><field name="package_id"/><field name="billable_minutes"/><field name="covered_minutes"/><field name="overage_minutes"/><field name="gross_amount"/><field name="package_credit_amount"/><field name="amount_total"/><field name="currency_id" column_invisible="1"/></list></field><group string="Liquidación"><field name="amount_gross"/><field name="amount_package"/><field name="amount_total"/><field name="currency_id" invisible="1"/></group></sheet><chatter/></form></field></record>
    <record id="action_rental_booking" model="ir.actions.act_window"><field name="name">Reservas y consumos</field><field name="res_model">odental.rental.booking</field><field name="view_mode">calendar,list,form</field></record>
</odoo>
