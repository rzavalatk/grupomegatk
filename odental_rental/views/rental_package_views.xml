<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_package_type_list" model="ir.ui.view"><field name="name">odental.rental.package.type.list</field><field name="model">odental.rental.package.type</field><field name="arch" type="xml"><list><field name="name"/><field name="organization_id"/><field name="resource_id"/><field name="category_id"/><field name="purchased_minutes"/><field name="bonus_minutes"/><field name="validity_days"/><field name="price"/><field name="currency_id" column_invisible="1"/><field name="active"/></list></field></record>
    <record id="view_rental_package_type_form" model="ir.ui.view"><field name="name">odental.rental.package.type.form</field><field name="model">odental.rental.package.type</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="organization_id"/><field name="resource_id" domain="[('organization_id', '=', organization_id), ('is_rentable', '=', True)]"/><field name="category_id" domain="[('organization_id', '=', organization_id)]"/></group><group><field name="purchased_minutes"/><field name="bonus_minutes"/><field name="validity_days"/><field name="price"/><field name="currency_id" invisible="1"/><field name="product_id"/><field name="active"/></group></group></sheet></form></field></record>
    <record id="action_rental_package_type" model="ir.actions.act_window"><field name="name">Tipos de paquete</field><field name="res_model">odental.rental.package.type</field><field name="view_mode">list,form</field></record>

    <record id="view_rental_package_list" model="ir.ui.view"><field name="name">odental.rental.package.list</field><field name="model">odental.rental.package</field><field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state in ('expired', 'cancelled', 'exhausted')"><field name="name"/><field name="professional_id"/><field name="package_type_id"/><field name="renter_organization_id"/><field name="expiration_date"/><field name="remaining_minutes"/><field name="state"/></list></field></record>
    <record id="view_rental_package_form" model="ir.ui.view"><field name="name">odental.rental.package.form</field><field name="model">odental.rental.package</field><field name="arch" type="xml"><form><header><button name="action_create_quotation" type="object" string="Crear cotización" invisible="sale_order_id or state != 'draft'"/><button name="action_activate" type="object" string="Activar saldo" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('cancelled', 'exhausted', 'expired')"/><field name="state" widget="statusbar" statusbar_visible="draft,active,exhausted,expired"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_quotation" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not sale_order_id"><field name="sale_order_id" string="Cotización" widget="statinfo"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="package_type_id" readonly="state != 'draft'"/><field name="provider_organization_id" readonly="1"/><field name="renter_organization_id" readonly="state != 'draft'"/><field name="professional_id" readonly="state != 'draft'"/></group><group><field name="purchase_date" readonly="state != 'draft'"/><field name="expiration_date"/><field name="payment_reference" readonly="state != 'draft'"/><field name="currency_id" invisible="1"/></group></group><group string="Saldo"><field name="total_minutes"/><field name="consumed_minutes"/><field name="remaining_minutes"/></group><field name="credit_move_ids" readonly="1"><list><field name="create_date"/><field name="move_type"/><field name="description"/><field name="minutes"/></list></field></sheet><chatter/></form></field></record>
    <record id="action_rental_package" model="ir.actions.act_window"><field name="name">Paquetes prepagados</field><field name="res_model">odental.rental.package</field><field name="view_mode">list,form</field></record>
</odoo>
