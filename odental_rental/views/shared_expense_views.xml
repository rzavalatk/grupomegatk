<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shared_expense_list" model="ir.ui.view"><field name="name">odental.shared.expense.list</field><field name="model">odental.shared.expense</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="description"/><field name="provider_organization_id"/><field name="period_start"/><field name="period_end"/><field name="allocation_method"/><field name="amount"/><field name="difference_amount"/><field name="currency_id" column_invisible="1"/><field name="state"/></list></field></record>
    <record id="view_shared_expense_form" model="ir.ui.view"><field name="name">odental.shared.expense.form</field><field name="model">odental.shared.expense</field><field name="arch" type="xml"><form><header><button name="action_load_professionals" type="object" string="Cargar profesionales" invisible="state == 'approved'"/><button name="action_calculate" type="object" string="Calcular reparto" class="btn-primary" invisible="state == 'approved'"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'calculated'"/><button name="action_cancel" type="object" string="Cancelar" invisible="state == 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved"/></header><sheet><div class="oe_title"><h1><field name="description"/></h1></div><group><group><field name="name"/><field name="provider_organization_id"/><field name="date"/><field name="amount"/><field name="currency_id" invisible="1"/></group><group><field name="period_start"/><field name="period_end"/><field name="allocation_method"/><field name="hybrid_fixed_pool" invisible="allocation_method != 'hybrid'"/></group></group><field name="line_ids" readonly="state == 'approved'"><list editable="bottom"><field name="professional_id"/><field name="percentage" column_invisible="parent.allocation_method != 'percentage'"/><field name="fixed_amount" column_invisible="parent.allocation_method != 'fixed'"/><field name="manual_amount" column_invisible="parent.allocation_method != 'manual'"/><field name="driver_value" column_invisible="parent.allocation_method in ('equal', 'percentage', 'fixed', 'manual')"/><field name="allocated_amount"/><field name="currency_id" column_invisible="1"/><field name="notes" optional="hide"/></list></field><group string="Control"><field name="allocated_amount"/><field name="difference_amount"/></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_shared_expense" model="ir.actions.act_window"><field name="name">Gastos compartidos</field><field name="res_model">odental.shared.expense</field><field name="view_mode">list,form</field></record>
</odoo>

