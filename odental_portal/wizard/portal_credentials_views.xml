<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_patient_portal_credentials_form" model="ir.ui.view">
        <field name="name">odental.patient.portal.credentials.form</field>
        <field name="model">odental.patient.portal.credentials</field>
        <field name="arch" type="xml">
            <form string="Acceso temporal del paciente">
                <sheet>
                    <div class="alert alert-warning" role="alert"><field name="warning" nolabel="1"/></div>
                    <group>
                        <field name="invitation_id"/>
                        <field name="access_url" widget="url"/>
                        <field name="otp"/>
                    </group>
                    <field name="qr_preview" nolabel="1" widget="html"/>
                </sheet>
                <footer><button string="Cerrar" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
