<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_patient_intake_list" model="ir.ui.view"><field name="name">odental.patient.intake.list</field><field name="model">odental.patient.intake</field><field name="arch" type="xml"><list decoration-warning="state == 'submitted'" decoration-success="state == 'incorporated'" decoration-muted="state == 'rejected'"><field name="name"/><field name="patient_id"/><field name="organization_id"/><field name="submitted_at"/><field name="truth_confirmed"/><field name="reviewed_by_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_odental_patient_intake_search" model="ir.ui.view"><field name="name">odental.patient.intake.search</field><field name="model">odental.patient.intake</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="organization_id"/><filter name="pending" string="Pendientes" domain="[('state', '=', 'submitted')]"/><filter name="reviewed" string="Revisados" domain="[('state', '=', 'reviewed')]"/><group expand="0" string="Agrupar por"><filter name="group_organization" string="Organización" context="{'group_by': 'organization_id'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group></search></field></record>
    <record id="view_odental_patient_intake_form" model="ir.ui.view"><field name="name">odental.patient.intake.form</field><field name="model">odental.patient.intake</field><field name="arch" type="xml"><form><header><button name="action_review" type="object" string="Marcar revisado" class="btn-primary" invisible="state != 'submitted'"/><button name="action_incorporate" type="object" string="Incorporar al expediente" class="btn-primary" groups="odental_core.group_odental_manager" invisible="state != 'reviewed'"/><button name="action_reject" type="object" string="Rechazar" invisible="state not in ('submitted', 'reviewed')"/><field name="state" widget="statusbar" statusbar_visible="submitted,reviewed,incorporated"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="patient_id"/><field name="clinical_record_id"/><field name="organization_id"/><field name="invitation_id"/></group><group><field name="submitted_at"/><field name="submitted_ip_address"/><field name="submitted_user_agent"/><field name="truth_confirmed"/></group></group><notebook><page string="Antecedentes declarados"><group><field name="allergies"/><field name="medications"/><field name="medical_conditions"/><field name="surgeries"/><field name="anesthesia_reactions"/><field name="pregnancy"/><field name="pregnancy_details" invisible="not pregnancy"/><field name="other_information"/></group></page><page string="Revisión"><field name="review_notes" readonly="state in ('incorporated', 'rejected')"/><group><field name="reviewed_at"/><field name="reviewed_by_id"/></group></page><page string="Incorporación"><field name="incorporated_entry_ids" widget="many2many_tags"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_odental_patient_intake" model="ir.actions.act_window"><field name="name">Formularios clínicos</field><field name="res_model">odental.patient.intake</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_odental_patient_intake_search"/></record>
</odoo>
