<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_patient_update_list" model="ir.ui.view"><field name="name">odental.patient.update.request.list</field><field name="model">odental.patient.update.request</field><field name="arch" type="xml"><list decoration-warning="state == 'submitted'" decoration-success="state == 'approved'" decoration-muted="state == 'rejected'"><field name="name"/><field name="patient_id"/><field name="organization_id"/><field name="submitted_at"/><field name="requested_mobile"/><field name="requested_email"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_odental_patient_update_search" model="ir.ui.view"><field name="name">odental.patient.update.request.search</field><field name="model">odental.patient.update.request</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="organization_id"/><filter name="pending" string="Pendientes" domain="[('state', '=', 'submitted')]"/><group expand="0" string="Agrupar por"><filter name="group_organization" string="Organización" context="{'group_by': 'organization_id'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group></search></field></record>
    <record id="view_odental_patient_update_form" model="ir.ui.view"><field name="name">odental.patient.update.request.form</field><field name="model">odental.patient.update.request</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Aprobar y aplicar" class="btn-primary" groups="odental_core.group_odental_manager" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Rechazar" groups="odental_core.group_odental_manager" invisible="state != 'submitted'"/><field name="state" widget="statusbar" statusbar_visible="submitted,approved,rejected"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Solicitud"><field name="patient_id"/><field name="requested_name"/><field name="requested_identification"/><field name="requested_birthdate"/><field name="requested_mobile"/><field name="requested_email"/></group><group string="Evidencia"><field name="invitation_id"/><field name="submitted_at"/><field name="submitted_ip_address"/><field name="submitted_user_agent"/><field name="previous_values_json" widget="text"/></group></group><group string="Revisión"><field name="review_notes" readonly="state != 'submitted'"/><field name="reviewed_at"/><field name="reviewed_by_id"/></group></sheet><chatter/></form></field></record>
    <record id="action_odental_patient_update" model="ir.actions.act_window"><field name="name">Actualizaciones de pacientes</field><field name="res_model">odental.patient.update.request</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_odental_patient_update_search"/></record>
</odoo>
