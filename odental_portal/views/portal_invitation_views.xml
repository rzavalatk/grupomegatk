<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_portal_invitation_list" model="ir.ui.view"><field name="name">odental.patient.portal.invitation.list</field><field name="model">odental.patient.portal.invitation</field><field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state in ('used', 'expired', 'revoked')"><field name="patient_id"/><field name="organization_id"/><field name="delivery_channel"/><field name="recipient"/><field name="expires_at"/><field name="token_hint"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_odental_portal_invitation_search" model="ir.ui.view"><field name="name">odental.patient.portal.invitation.search</field><field name="model">odental.patient.portal.invitation</field><field name="arch" type="xml"><search><field name="patient_id"/><field name="organization_id"/><field name="recipient"/><filter name="active" string="Activas" domain="[('state', '=', 'active')]"/><filter name="expired" string="Vencidas" domain="[('state', '=', 'expired')]"/><group expand="0" string="Agrupar por"><filter name="group_organization" string="Organización" context="{'group_by': 'organization_id'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group></search></field></record>
    <record id="view_odental_portal_invitation_form" model="ir.ui.view"><field name="name">odental.patient.portal.invitation.form</field><field name="model">odental.patient.portal.invitation</field><field name="arch" type="xml"><form><header><button name="action_prepare_access" type="object" string="Generar enlace y QR" class="btn-primary" invisible="state not in ('draft', 'active')"/><button name="action_revoke" type="object" string="Revocar" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,used,expired,revoked"/></header><sheet><group><group><field name="patient_id" readonly="state != 'draft'"/><field name="organization_id"/><field name="delivery_channel" readonly="state != 'draft'"/><field name="recipient" readonly="state != 'draft'"/></group><group><field name="valid_hours" readonly="state != 'draft'"/><field name="max_attempts" readonly="state != 'draft'"/><field name="expires_at"/><field name="token_hint"/></group></group><group string="Uso"><field name="used_at"/><field name="used_ip_address"/><field name="revoked_at"/><field name="revoked_by_id"/></group><field name="revocation_reason" readonly="state == 'revoked'" placeholder="Obligatorio antes de revocar..."/></sheet><chatter/></form></field></record>
    <record id="action_odental_portal_invitation" model="ir.actions.act_window"><field name="name">Invitaciones de registro</field><field name="res_model">odental.patient.portal.invitation</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_odental_portal_invitation_search"/></record>
</odoo>
