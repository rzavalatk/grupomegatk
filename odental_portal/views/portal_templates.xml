<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_odental" name="O Dental en mi portal" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">O Dental</t>
                <t t-set="text">Citas, tratamientos, facturas y consentimientos</t>
                <t t-set="url" t-value="'/my/odental'"/>
                <t t-set="placeholder_count" t-value="'odental_patient_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_invalid" name="O Dental - Acceso no disponible">
        <t t-call="web.frontend_layout"><main class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body p-5 text-center"><p class="text-uppercase text-primary small fw-bold">O Dental</p><h1 class="h3">Acceso no disponible</h1><p class="text-muted mb-0" t-esc="message"/></div></div></div></div></main></t>
    </template>

    <template id="portal_registration_verify" name="O Dental - Verificar registro">
        <t t-call="web.frontend_layout"><main class="container py-5"><div class="row justify-content-center"><div class="col-md-7 col-lg-5"><div class="card shadow-sm border-0"><div class="card-body p-4 p-md-5"><p class="text-uppercase text-primary small fw-bold mb-2">O Dental · Registro seguro</p><h1 class="h3">Verifique su identidad</h1><p class="text-muted">La organización <strong t-esc="invitation.organization_id.name"/> preparó este acceso para actualizar su información.</p><div t-if="error" class="alert alert-danger" t-esc="error"/><form t-att-action="'/odental/register/%s/verify' % token" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label class="form-label" for="portal_code">Código temporal de seis dígitos</label><input id="portal_code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" class="form-control form-control-lg text-center" required="required"/><button type="submit" class="btn btn-primary w-100 mt-3">Verificar identidad</button></form><p class="small text-muted mt-4 mb-0">Los intentos fallidos se registran y el acceso se bloquea temporalmente al superar el límite.</p></div></div></div></div></main></t>
    </template>

    <template id="portal_registration_form" name="O Dental - Formulario de registro">
        <t t-call="web.frontend_layout"><main class="container py-4"><div class="row justify-content-center"><div class="col-xl-9"><div class="card shadow-sm border-0"><div class="card-body p-4 p-md-5"><p class="text-uppercase text-primary small fw-bold mb-2">O Dental · Información del paciente</p><h1 class="h3">Actualice sus datos</h1><p class="text-muted">Sus respuestas serán revisadas por <strong t-esc="invitation.organization_id.name"/> antes de incorporarse. Este formulario no modifica automáticamente su expediente.</p><div t-if="error" class="alert alert-danger" t-esc="error"/>
            <form t-att-action="'/odental/register/%s/submit' % token" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h2 class="h5 mt-4">Datos personales</h2><div class="row g-3"><div class="col-md-6"><label class="form-label" for="patient_name">Nombre completo</label><input id="patient_name" name="name" type="text" class="form-control" maxlength="200" required="required" t-att-value="form_values.get('name') or patient.name"/></div><div class="col-md-6"><label class="form-label" for="identification">Identificación</label><input id="identification" name="identification" type="text" class="form-control" maxlength="80" t-att-value="form_values.get('identification') or patient.identification"/></div><div class="col-md-4"><label class="form-label" for="birthdate">Fecha de nacimiento</label><input id="birthdate" name="birthdate" type="date" class="form-control" t-att-value="form_values.get('birthdate') or patient.birthdate"/></div><div class="col-md-4"><label class="form-label" for="mobile">Teléfono</label><input id="mobile" name="mobile" type="tel" class="form-control" maxlength="40" t-att-value="form_values.get('mobile') or patient.mobile"/></div><div class="col-md-4"><label class="form-label" for="email">Correo</label><input id="email" name="email" type="email" class="form-control" maxlength="254" t-att-value="form_values.get('email') or patient.email"/></div></div>
                <hr class="my-4"/><h2 class="h5">Información importante para su atención</h2><p class="small text-muted">Escriba “ninguna” cuando corresponda. El profesional revisará cada respuesta.</p><div class="row g-3"><div class="col-md-6"><label class="form-label" for="allergies">Alergias</label><textarea id="allergies" name="allergies" rows="3" maxlength="3000" class="form-control"><t t-esc="form_values.get('allergies')"/></textarea></div><div class="col-md-6"><label class="form-label" for="medications">Medicamentos actuales</label><textarea id="medications" name="medications" rows="3" maxlength="3000" class="form-control"><t t-esc="form_values.get('medications')"/></textarea></div><div class="col-md-6"><label class="form-label" for="medical_conditions">Condiciones médicas</label><textarea id="medical_conditions" name="medical_conditions" rows="3" maxlength="3000" class="form-control"><t t-esc="form_values.get('medical_conditions')"/></textarea></div><div class="col-md-6"><label class="form-label" for="surgeries">Cirugías u hospitalizaciones</label><textarea id="surgeries" name="surgeries" rows="3" maxlength="3000" class="form-control"><t t-esc="form_values.get('surgeries')"/></textarea></div><div class="col-12"><label class="form-label" for="anesthesia_reactions">Reacciones previas a anestesia</label><textarea id="anesthesia_reactions" name="anesthesia_reactions" rows="2" maxlength="3000" class="form-control"><t t-esc="form_values.get('anesthesia_reactions')"/></textarea></div><div class="col-md-4"><div class="form-check mt-4"><input id="pregnancy" name="pregnancy" value="yes" type="checkbox" class="form-check-input" t-att-checked="form_values.get('pregnancy') == 'yes'"/><label class="form-check-label" for="pregnancy">Actualmente embarazada</label></div></div><div class="col-md-8"><label class="form-label" for="pregnancy_details">Semanas u observaciones</label><input id="pregnancy_details" name="pregnancy_details" type="text" maxlength="300" class="form-control" t-att-value="form_values.get('pregnancy_details')"/></div><div class="col-12"><label class="form-label" for="other_information">Otra información relevante</label><textarea id="other_information" name="other_information" rows="3" maxlength="3000" class="form-control"><t t-esc="form_values.get('other_information')"/></textarea></div></div>
                <div class="form-check mt-4"><input id="truth_confirmed" name="truth_confirmed" value="yes" type="checkbox" class="form-check-input" required="required"/><label class="form-check-label" for="truth_confirmed">Confirmo que la información suministrada es verdadera y completa según mi conocimiento.</label></div><button type="submit" class="btn btn-primary btn-lg mt-4">Enviar para revisión</button>
            </form></div></div></div></div></main></t>
    </template>

    <template id="portal_registration_received" name="O Dental - Formulario recibido">
        <t t-call="web.frontend_layout"><main class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body p-5 text-center"><div class="text-success display-5 mb-3">✓</div><h1 class="h3">Información recibida</h1><p class="text-muted">Gracias, <strong t-esc="patient.name"/>. La clínica revisará los datos personales y clínicos antes de incorporarlos.</p><p class="small text-muted mb-0">Referencias: <span t-esc="update.name"/> · <span t-esc="intake.name"/></p></div></div></div></div></main></t>
    </template>

    <template id="portal_patient_home" name="O Dental - Mi portal">
        <t t-call="portal.portal_layout"><div class="container py-4"><div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary small fw-bold mb-1">O Dental</p><h1 class="h3 mb-0">Hola, <span t-esc="patient.name"/></h1></div></div>
            <div class="row g-4"><div class="col-lg-6"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h2 class="h5">Próximas citas</h2><div t-if="not appointments" class="text-muted">No tiene citas próximas.</div><div t-foreach="appointments" t-as="appointment" class="border-top py-3"><strong t-esc="appointment.service_id.name"/><div class="small text-muted"><span t-field="appointment.start_datetime" t-options="{'widget': 'datetime'}"/> · <span t-esc="appointment.professional_id.name"/></div><span class="badge text-bg-light" t-esc="dict(appointment._fields['state'].selection).get(appointment.state)"/></div></div></div></div>
            <div class="col-lg-6"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h2 class="h5">Consentimientos pendientes</h2><div t-if="not consents" class="text-muted">No tiene documentos pendientes.</div><div t-foreach="consents" t-as="consent" class="border-top py-3"><strong t-esc="consent.template_name"/><p class="small text-muted mb-2" t-esc="consent.scope_summary"/><a class="btn btn-sm btn-primary" t-att-href="'/my/odental/consent/%s' % consent.id">Revisar y firmar</a></div></div></div></div>
            <div class="col-12"><div class="card shadow-sm border-0"><div class="card-body"><h2 class="h5">Planes de tratamiento</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Plan</th><th>Estado</th><th class="text-end">Total</th></tr></thead><tbody><tr t-if="not plans"><td colspan="3" class="text-muted">No hay planes disponibles.</td></tr><tr t-foreach="plans" t-as="plan"><td><span t-esc="plan.name"/> · versión <span t-esc="plan.version"/></td><td t-esc="dict(plan._fields['state'].selection).get(plan.state)"/><td class="text-end"><span t-esc="plan.amount_total"/> <span t-esc="plan.currency_id.name"/></td></tr></tbody></table></div></div></div></div>
            <div class="col-lg-6"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h2 class="h5">Facturas</h2><div t-if="not invoices" class="text-muted">No hay facturas publicadas.</div><div t-foreach="invoices" t-as="invoice" class="border-top py-3"><div class="d-flex justify-content-between"><strong t-esc="invoice.name"/><span><span t-esc="invoice.amount_total"/> <span t-esc="invoice.currency_id.name"/></span></div><div class="small text-muted">Saldo: <span t-esc="invoice.amount_residual"/> · <span t-esc="invoice.payment_state"/></div></div></div></div></div>
            <div class="col-lg-6"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h2 class="h5">Convenios de pago</h2><div t-if="not agreements" class="text-muted">No tiene convenios registrados.</div><div t-foreach="agreements" t-as="agreement" class="border-top py-3"><div class="d-flex justify-content-between"><strong t-esc="agreement.name"/><span class="badge text-bg-light" t-esc="dict(agreement._fields['state'].selection).get(agreement.state)"/></div><div class="small text-muted">Saldo: <span t-esc="agreement.balance_amount"/> <span t-esc="agreement.currency_id.name"/></div></div></div></div></div></div>
            <div class="alert alert-info mt-4">Por seguridad, este portal no muestra antecedentes restringidos, notas clínicas internas ni archivos completos sin una autorización específica.</div></div></t>
    </template>

    <template id="portal_patient_consent" name="O Dental - Consentimiento del paciente">
        <t t-call="portal.portal_layout"><div class="container py-4"><div class="row justify-content-center"><div class="col-lg-8"><div class="card shadow-sm border-0"><div class="card-body p-4 p-md-5"><p class="text-uppercase text-primary small fw-bold">O Dental · Consentimiento</p><h1 class="h3" t-esc="consent.template_name"/><p class="text-muted" t-esc="consent.scope_summary"/><div t-if="error" class="alert alert-danger" t-esc="error"/><section class="border rounded p-3 p-md-4 mb-4"><div t-field="consent.consent_text"/></section><form t-att-action="'/my/odental/consent/%s' % consent.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-3"><div class="col-md-6"><label class="form-label">Nombre del firmante</label><input name="signer_name" type="text" class="form-control" required="required" t-att-value="patient.name"/></div><div class="col-md-6"><label class="form-label">Identificación</label><input name="signer_identification" type="text" class="form-control" required="required" t-att-value="patient.identification"/></div><div class="col-12"><label class="form-label">Firma como</label><select name="signer_type" class="form-select"><option value="patient">Paciente</option><option value="representative">Representante legal</option></select></div></div><div class="form-check mt-4"><input id="accepted" name="accepted" value="yes" type="checkbox" class="form-check-input" required="required"/><label for="accepted" class="form-check-label">Confirmo que leí el documento y acepto únicamente el alcance descrito.</label></div><button type="submit" class="btn btn-primary mt-4">Firmar consentimiento</button></form></div></div></div></div></div></t>
    </template>

    <template id="portal_patient_consent_signed" name="O Dental - Consentimiento firmado">
        <t t-call="portal.portal_layout"><div class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body p-5 text-center"><div class="text-success display-5 mb-3">✓</div><h1 class="h3">Consentimiento firmado</h1><p class="text-muted">El documento <strong t-esc="consent.name"/> quedó firmado, fechado y protegido con una huella digital.</p><a href="/my/odental" class="btn btn-primary">Volver a mi portal</a></div></div></div></div></div></t>
    </template>
</odoo>
