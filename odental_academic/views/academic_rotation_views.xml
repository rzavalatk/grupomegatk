<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_rotation_list" model="ir.ui.view">
        <field name="name">odental.academic.rotation.list</field><field name="model">odental.academic.rotation</field>
        <field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="period_id"/><field name="service_area"/><field name="date_start"/><field name="date_end"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_academic_rotation_form" model="ir.ui.view">
        <field name="name">odental.academic.rotation.form</field><field name="model">odental.academic.rotation</field>
        <field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activar rotación" class="btn-primary" invisible="state != 'draft'"/><button name="action_close" type="object" string="Cerrar rotación" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="code" readonly="state != 'draft'"/><field name="period_id" readonly="state != 'draft'"/><field name="organization_id" readonly="1"/><field name="service_area" readonly="state != 'draft'"/></group><group><field name="date_start" readonly="state != 'draft'"/><field name="date_end" readonly="state != 'draft'"/></group></group><notebook><page string="Participantes"><group><field name="student_user_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="supervisor_user_ids" widget="many2many_tags" readonly="state != 'draft'"/></group></page><page string="Casos"><field name="case_ids" context="{'default_rotation_id': id}"><list create="0"><field name="name"/><field name="patient_display_name"/><field name="student_user_id"/><field name="supervisor_user_id"/><field name="access_end"/><field name="state" widget="badge"/></list></field></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="view_academic_rotation_search" model="ir.ui.view">
        <field name="name">odental.academic.rotation.search</field><field name="model">odental.academic.rotation</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="period_id"/><field name="organization_id"/><filter name="active" string="Activas" domain="[('state', '=', 'active')]"/><group expand="0" string="Agrupar por"><filter name="group_period" string="Período" context="{'group_by': 'period_id'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group></search></field>
    </record>
    <record id="action_academic_rotation" model="ir.actions.act_window"><field name="name">Rotaciones clínicas</field><field name="res_model">odental.academic.rotation</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_academic_rotation_search"/><field name="context">{'search_default_active': 1}</field></record>
</odoo>

