<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_case_list" model="ir.ui.view">
        <field name="name">odental.academic.case.list</field><field name="model">odental.academic.case</field>
        <field name="arch" type="xml"><list create="0"><field name="name"/><field name="patient_display_name"/><field name="rotation_id"/><field name="student_user_id" groups="odental_academic.group_odental_academic_supervisor"/><field name="supervisor_user_id"/><field name="access_start"/><field name="access_end"/><field name="approved_count"/><field name="state" widget="badge" decoration-success="state == 'completed'" decoration-danger="state in ('revoked', 'expired')"/></list></field>
    </record>
    <record id="view_academic_case_form_supervisor" model="ir.ui.view">
        <field name="name">odental.academic.case.form.supervisor</field><field name="model">odental.academic.case</field><field name="priority">10</field><field name="groups_id" eval="[(6, 0, [ref('odental_academic.group_odental_academic_supervisor')])]"/>
        <field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Asignar al estudiante" class="btn-primary" invisible="state != 'draft'"/><button name="action_complete" type="object" string="Finalizar caso" class="btn-primary" invisible="state != 'active'"/><button name="action_revoke" type="object" string="Revocar acceso" invisible="state not in ('draft', 'active')" confirm="El estudiante perderá acceso al caso."/><field name="state" widget="statusbar" statusbar_visible="draft,active,completed,revoked,expired"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="rotation_id" readonly="state != 'draft'"/><field name="patient_id" readonly="state != 'draft'"/><field name="student_user_id" readonly="state != 'draft'"/><field name="student_number" readonly="state != 'draft'"/></group><group><field name="supervisor_user_id" readonly="state != 'draft'"/><field name="supervisor_professional_id" readonly="state != 'draft'"/><field name="access_start" readonly="state != 'draft'"/><field name="access_end" readonly="state != 'draft'"/><field name="submission_count" readonly="1"/><field name="approved_count" readonly="1"/></group></group><notebook><page string="Ficha mínima"><field name="reason_for_care"/><field name="relevant_alerts"/><field name="instructions"/></page><page string="Trabajos"><field name="submission_ids" context="{'default_case_id': id}"><list create="0"><field name="name"/><field name="submission_type"/><field name="procedure_name"/><field name="state" widget="badge"/><field name="supervisor_score"/><field name="competency"/></list></field></page><page string="Cierre"><field name="revocation_reason" placeholder="Obligatorio para revocar..." readonly="state not in ('draft', 'active')"/><field name="completed_by_id" readonly="1"/><field name="completed_at" readonly="1"/></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="view_academic_case_form_student" model="ir.ui.view">
        <field name="name">odental.academic.case.form.student</field><field name="model">odental.academic.case</field><field name="priority">20</field><field name="groups_id" eval="[(6, 0, [ref('odental_academic.group_odental_academic_student')])]"/>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1><p class="text-muted">Caso asignado; el expediente completo permanece bajo custodia institucional.</p></div><group><group><field name="patient_display_name" readonly="1"/><field name="patient_reference" readonly="1"/><field name="rotation_id" readonly="1"/></group><group><field name="supervisor_user_id" readonly="1"/><field name="access_start" readonly="1"/><field name="access_end" readonly="1"/><field name="state" readonly="1" widget="badge"/></group></group><notebook><page string="Información autorizada"><field name="reason_for_care" readonly="1"/><field name="relevant_alerts" readonly="1"/><field name="instructions" readonly="1"/></page><page string="Mis trabajos"><field name="submission_ids" context="{'default_case_id': id}"><list><field name="name"/><field name="submission_type"/><field name="procedure_name"/><field name="state" widget="badge"/><field name="supervisor_score"/><field name="competency"/></list></field></page></notebook></sheet></form></field>
    </record>
    <record id="view_academic_case_search" model="ir.ui.view">
        <field name="name">odental.academic.case.search</field><field name="model">odental.academic.case</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="patient_display_name"/><field name="student_user_id"/><field name="supervisor_user_id"/><filter name="active" string="Asignados" domain="[('state', '=', 'active')]"/><filter name="review" string="Con revisión pendiente" domain="[('submission_ids.state', 'in', ('submitted', 'approved'))]"/><group expand="0" string="Agrupar por"><filter name="group_student" string="Estudiante" context="{'group_by': 'student_user_id'}"/><filter name="group_rotation" string="Rotación" context="{'group_by': 'rotation_id'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group></search></field>
    </record>
    <record id="action_academic_case" model="ir.actions.act_window"><field name="name">Casos académicos</field><field name="res_model">odental.academic.case</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_academic_case_search"/></record>
    <record id="action_academic_my_case" model="ir.actions.act_window"><field name="name">Mis casos asignados</field><field name="res_model">odental.academic.case</field><field name="view_mode">list,form</field><field name="domain">[('student_user_id', '=', uid)]</field></record>
</odoo>
