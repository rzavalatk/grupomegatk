<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_submission_list" model="ir.ui.view">
        <field name="name">odental.academic.submission.list</field><field name="model">odental.academic.submission</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="patient_display_name"/><field name="student_user_id" groups="odental_academic.group_odental_academic_supervisor"/><field name="submission_type"/><field name="procedure_name"/><field name="submitted_at"/><field name="supervisor_score"/><field name="competency"/><field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state == 'approved'" decoration-danger="state == 'rejected'" decoration-success="state == 'applied'"/></list></field>
    </record>
    <record id="view_academic_submission_form_supervisor" model="ir.ui.view">
        <field name="name">odental.academic.submission.form.supervisor</field><field name="model">odental.academic.submission</field><field name="priority">10</field><field name="groups_id" eval="[(6, 0, [ref('odental_academic.group_odental_academic_supervisor')])]"/>
        <field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Devolver para corrección" invisible="state != 'submitted'"/><button name="action_apply" type="object" string="Incorporar como borrador clínico" class="btn-primary" invisible="state != 'approved'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,applied"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div><group><group><field name="case_id" readonly="1"/><field name="patient_display_name" readonly="1"/><field name="student_user_id" readonly="1"/><field name="submission_type" readonly="1"/></group><group><field name="submitted_at" readonly="1"/><field name="submitted_hash" readonly="1" password="True"/><field name="previous_submission_id" readonly="1"/></group></group><group string="Procedimiento"><field name="procedure_code" readonly="1"/><field name="procedure_name" readonly="1"/></group><group string="Hallazgo" invisible="submission_type != 'odontogram_finding'"><field name="tooth_code" readonly="1"/><field name="surface" readonly="1"/><field name="condition" readonly="1"/><field name="finding_status" readonly="1"/></group><field name="content" readonly="1"/><group string="Evaluación docente"><field name="supervisor_comments" readonly="state != 'submitted'"/><field name="supervisor_score" readonly="state != 'submitted'"/><field name="competency" readonly="state != 'submitted'"/><field name="reviewed_by_id" readonly="1"/><field name="reviewed_at" readonly="1"/><field name="approval_hash" readonly="1" password="True"/></group><group string="Incorporación" invisible="not target_model"><field name="target_model" readonly="1"/><field name="target_res_id" readonly="1"/><field name="applied_at" readonly="1"/></group></sheet><chatter/></form></field>
    </record>
    <record id="view_academic_submission_form_student" model="ir.ui.view">
        <field name="name">odental.academic.submission.form.student</field><field name="model">odental.academic.submission</field><field name="priority">20</field><field name="groups_id" eval="[(6, 0, [ref('odental_academic.group_odental_academic_student')])]"/>
        <field name="arch" type="xml"><form delete="0"><header><button name="action_submit" type="object" string="Enviar al docente" class="btn-primary" invisible="state != 'draft'"/><button name="action_create_revision" type="object" string="Crear corrección" class="btn-primary" invisible="state != 'rejected'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,applied"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div><group><field name="case_id" readonly="state != 'draft'"/><field name="patient_display_name" readonly="1"/><field name="submission_type" readonly="state != 'draft'"/><field name="previous_submission_id" readonly="1"/></group><group string="Procedimiento" invisible="submission_type == 'odontogram_finding'"><field name="procedure_code" readonly="state != 'draft'"/><field name="procedure_name" readonly="state != 'draft'"/></group><group string="Hallazgo odontológico" invisible="submission_type != 'odontogram_finding'"><field name="tooth_code" readonly="state != 'draft'"/><field name="surface" readonly="state != 'draft'"/><field name="condition" readonly="state != 'draft'"/><field name="finding_status" readonly="state != 'draft'"/></group><field name="content" readonly="state != 'draft'"/><group string="Respuesta del docente" invisible="state == 'draft'"><field name="supervisor_comments" readonly="1"/><field name="supervisor_score" readonly="1"/><field name="competency" readonly="1"/><field name="reviewed_at" readonly="1"/></group><field name="revision_ids" readonly="1"><list><field name="name"/><field name="create_date"/><field name="state"/></list></field></sheet><chatter/></form></field>
    </record>
    <record id="view_academic_submission_search" model="ir.ui.view">
        <field name="name">odental.academic.submission.search</field><field name="model">odental.academic.submission</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="patient_display_name"/><field name="student_user_id"/><field name="procedure_name"/><filter name="review" string="Por revisar" domain="[('state', '=', 'submitted')]"/><filter name="approved" string="Por incorporar" domain="[('state', '=', 'approved')]"/><filter name="rejected" string="Devueltos" domain="[('state', '=', 'rejected')]"/><group expand="0" string="Agrupar por"><filter name="group_student" string="Estudiante" context="{'group_by': 'student_user_id'}"/><filter name="group_rotation" string="Rotación" context="{'group_by': 'rotation_id'}"/><filter name="group_type" string="Tipo" context="{'group_by': 'submission_type'}"/><filter name="group_competency" string="Competencia" context="{'group_by': 'competency'}"/></group></search></field>
    </record>
    <record id="view_academic_submission_pivot" model="ir.ui.view">
        <field name="name">odental.academic.submission.pivot</field><field name="model">odental.academic.submission</field>
        <field name="arch" type="xml"><pivot string="Experiencia clínica"><field name="student_user_id" type="row"/><field name="procedure_name" type="row"/><field name="state" type="col"/><field name="submission_count" type="measure"/><field name="supervisor_score" type="measure"/></pivot></field>
    </record>
    <record id="view_academic_submission_graph" model="ir.ui.view">
        <field name="name">odental.academic.submission.graph</field><field name="model">odental.academic.submission</field>
        <field name="arch" type="xml"><graph string="Procedimientos por estudiante" type="bar"><field name="student_user_id"/><field name="submission_count" type="measure"/></graph></field>
    </record>
    <record id="view_academic_audit_list" model="ir.ui.view">
        <field name="name">odental.academic.audit.list</field><field name="model">odental.academic.audit</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="occurred_at"/><field name="case_id"/><field name="submission_id"/><field name="user_id"/><field name="event_type"/><field name="summary"/><field name="content_hash" optional="hide"/></list></field>
    </record>
    <record id="action_academic_submission" model="ir.actions.act_window"><field name="name">Trabajos clínicos</field><field name="res_model">odental.academic.submission</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_academic_submission_search"/><field name="context">{'search_default_review': 1}</field></record>
    <record id="action_academic_my_submission" model="ir.actions.act_window"><field name="name">Mis trabajos</field><field name="res_model">odental.academic.submission</field><field name="view_mode">list,form</field><field name="domain">[('student_user_id', '=', uid)]</field></record>
    <record id="action_academic_report" model="ir.actions.act_window"><field name="name">Experiencia clínica</field><field name="res_model">odental.academic.submission</field><field name="view_mode">pivot,graph,list</field><field name="domain">[('state', 'in', ('approved', 'applied'))]</field></record>
    <record id="action_academic_audit" model="ir.actions.act_window"><field name="name">Auditoría académica</field><field name="res_model">odental.academic.audit</field><field name="view_mode">list</field></record>
</odoo>

