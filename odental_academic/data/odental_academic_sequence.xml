<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_odental_academic_case" model="ir.sequence">
        <field name="name">Caso académico O Dental</field>
        <field name="code">odental.academic.case</field>
        <field name="prefix">ACAD/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_odental_academic_submission" model="ir.sequence">
        <field name="name">Trabajo académico O Dental</field>
        <field name="code">odental.academic.submission</field>
        <field name="prefix">TRAB/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

