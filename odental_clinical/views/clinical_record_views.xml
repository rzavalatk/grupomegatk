<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_patient_form_clinical" model="ir.ui.view">
        <field name="name">odental.patient.form.clinical</field>
        <field name="model">odental.patient</field>
        <field name="inherit_id" ref="odental_core.view_odental_patient_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_new_appointment']" position="after">
                <button name="action_open_clinical_record" type="object"
                        string="Expediente clínico" icon="fa-folder-open"
                        groups="odental_core.group_odental_professional"/>
            </xpath>
        </field>
    </record>
    <record id="view_odental_clinical_record_list" model="ir.ui.view">
        <field name="name">odental.clinical.record.list</field>
        <field name="model">odental.clinical.record</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'">
                <field name="patient_id"/>
                <field name="organization_id"/>
                <field name="blood_type"/>
                <field name="opened_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_odental_clinical_record_form" model="ir.ui.view">
        <field name="name">odental.clinical.record.form</field>
        <field name="model">odental.clinical.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Cerrar expediente" invisible="state != 'active'"/>
                    <button name="action_reopen" type="object" string="Reabrir expediente" class="btn-primary" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="patient_id"/>
                        <h1><field name="patient_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="organization_id" readonly="1"/>
                            <field name="opened_at" readonly="1"/>
                            <field name="blood_type"/>
                        </group>
                        <group>
                            <field name="alerts" placeholder="Alergias críticas, anticoagulantes u otras alertas..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Anamnesis">
                            <group col="1" string="Relato del paciente">
                                <field name="anamnesis_chief_complaint" readonly="state == 'closed'"
                                       placeholder="Registre el motivo de consulta con las palabras del paciente."/>
                                <field name="anamnesis_present_illness" readonly="state == 'closed'"
                                       placeholder="Desde cuándo comenzaron los síntomas, cómo han evolucionado, qué los mejora o empeora y qué ha intentado el paciente."/>
                            </group>
                            <separator string="Antecedentes médicos y odontológicos generales"/>
                            <div class="odental-anamnesis-help">Marque los antecedentes presentes. Una casilla sin marcar significa «no registrado», no una respuesta negativa.</div>
                            <div class="odental-anamnesis-grid">
                                <div class="odental-anamnesis-column">
                                    <h4>Salud general</h4>
                                    <div class="odental-history-item"><field name="hx_allergies" nolabel="1" readonly="state == 'closed'"/><label for="hx_allergies"/></div>
                                    <div class="odental-history-item"><field name="hx_blood_disorders" nolabel="1" readonly="state == 'closed'"/><label for="hx_blood_disorders"/></div>
                                    <div class="odental-history-item"><field name="hx_heart_disease" nolabel="1" readonly="state == 'closed'"/><label for="hx_heart_disease"/></div>
                                    <div class="odental-history-item"><field name="hx_pregnancy" nolabel="1" readonly="state == 'closed'"/><label for="hx_pregnancy"/></div>
                                    <div class="odental-history-item"><field name="hx_blood_pressure_changes" nolabel="1" readonly="state == 'closed'"/><label for="hx_blood_pressure_changes"/></div>
                                    <div class="odental-history-item"><field name="hx_medications" nolabel="1" readonly="state == 'closed'"/><label for="hx_medications"/></div>
                                    <div class="odental-history-item"><field name="hx_current_medical_treatment" nolabel="1" readonly="state == 'closed'"/><label for="hx_current_medical_treatment"/></div>
                                    <div class="odental-history-item"><field name="hx_headaches" nolabel="1" readonly="state == 'closed'"/><label for="hx_headaches"/></div>
                                </div>
                                <div class="odental-anamnesis-column">
                                    <h4>Enfermedades y condiciones</h4>
                                    <div class="odental-history-item"><field name="hx_hepatitis" nolabel="1" readonly="state == 'closed'"/><label for="hx_hepatitis"/></div>
                                    <div class="odental-history-item"><field name="hx_diabetes" nolabel="1" readonly="state == 'closed'"/><label for="hx_diabetes"/></div>
                                    <div class="odental-history-item"><field name="hx_rheumatic_fever" nolabel="1" readonly="state == 'closed'"/><label for="hx_rheumatic_fever"/></div>
                                    <div class="odental-history-item"><field name="hx_hiv_aids" nolabel="1" readonly="state == 'closed'"/><label for="hx_hiv_aids"/></div>
                                    <div class="odental-history-item"><field name="hx_immunosuppression" nolabel="1" readonly="state == 'closed'"/><label for="hx_immunosuppression"/></div>
                                    <div class="odental-history-item"><field name="hx_kidney_disease" nolabel="1" readonly="state == 'closed'"/><label for="hx_kidney_disease"/></div>
                                    <div class="odental-history-item"><field name="hx_respiratory_disease" nolabel="1" readonly="state == 'closed'"/><label for="hx_respiratory_disease"/></div>
                                    <div class="odental-history-item"><field name="hx_hormonal_disorders" nolabel="1" readonly="state == 'closed'"/><label for="hx_hormonal_disorders"/></div>
                                </div>
                                <div class="odental-anamnesis-column">
                                    <h4>Otros antecedentes</h4>
                                    <div class="odental-history-item"><field name="hx_gastric_disorders" nolabel="1" readonly="state == 'closed'"/><label for="hx_gastric_disorders"/></div>
                                    <div class="odental-history-item"><field name="hx_emotional_disorders" nolabel="1" readonly="state == 'closed'"/><label for="hx_emotional_disorders"/></div>
                                    <div class="odental-history-item"><field name="hx_loss_of_consciousness" nolabel="1" readonly="state == 'closed'"/><label for="hx_loss_of_consciousness"/></div>
                                    <div class="odental-history-item"><field name="hx_sinusitis" nolabel="1" readonly="state == 'closed'"/><label for="hx_sinusitis"/></div>
                                    <div class="odental-history-item"><field name="hx_surgeries" nolabel="1" readonly="state == 'closed'"/><label for="hx_surgeries"/></div>
                                    <div class="odental-history-item"><field name="hx_extractions" nolabel="1" readonly="state == 'closed'"/><label for="hx_extractions"/></div>
                                    <div class="odental-history-item"><field name="hx_oral_diseases" nolabel="1" readonly="state == 'closed'"/><label for="hx_oral_diseases"/></div>
                                    <div class="odental-history-item"><field name="hx_oral_appliances" nolabel="1" readonly="state == 'closed'"/><label for="hx_oral_appliances"/></div>
                                </div>
                            </div>
                            <group col="2" string="Información adicional">
                                <field name="anamnesis_oral_habits" readonly="state == 'closed'"/>
                                <field name="anamnesis_other_history" readonly="state == 'closed'"/>
                                <field name="anamnesis_positive_details" readonly="state == 'closed'"/>
                                <field name="anamnesis_observations" readonly="state == 'closed'"/>
                            </group>
                            <group col="4" string="Signos vitales">
                                <field name="anamnesis_pulse" readonly="state == 'closed'"/>
                                <field name="anamnesis_blood_pressure" readonly="state == 'closed'"/>
                                <field name="anamnesis_temperature" readonly="state == 'closed'"/>
                                <field name="anamnesis_respiratory_rate" readonly="state == 'closed'"/>
                            </group>
                            <separator string="Antecedentes detallados"/>
                            <field name="history_entry_ids" context="{'default_clinical_record_id': id}" readonly="state == 'closed'">
                                <list editable="bottom" decoration-danger="severity == 'critical'" decoration-warning="sensitivity == 'restricted'">
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="severity"/>
                                    <field name="clinically_relevant"/>
                                    <field name="sensitivity"/>
                                    <field name="referral_sharing"/>
                                </list>
                                <form>
                                    <group>
                                        <group><field name="category"/><field name="name"/><field name="status"/><field name="severity"/></group>
                                        <group><field name="start_date"/><field name="end_date"/><field name="clinically_relevant"/><field name="sensitivity"/><field name="referral_sharing"/></group>
                                    </group>
                                    <field name="details"/>
                                </form>
                            </field>
                        </page>
                        <page string="Evoluciones">
                            <field name="encounter_ids" context="{'default_clinical_record_id': id}">
                                <list><field name="name"/><field name="encounter_datetime"/><field name="professional_id"/><field name="version"/><field name="state"/></list>
                            </field>
                        </page>
                        <page string="Consentimientos">
                            <field name="consent_ids" context="{'default_clinical_record_id': id}">
                                <list><field name="name"/><field name="template_name"/><field name="purpose"/><field name="signer_name"/><field name="signed_at"/><field name="state"/></list>
                            </field>
                        </page>
                        <page string="Observaciones"><field name="general_notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_odental_clinical_record" model="ir.actions.act_window">
        <field name="name">Expedientes clínicos</field>
        <field name="res_model">odental.clinical.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
