<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_odental_clinical_encounter" model="ir.sequence">
        <field name="name">Evolución clínica O Dental</field>
        <field name="code">odental.clinical.encounter</field>
        <field name="prefix">EVO/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_odental_patient_consent" model="ir.sequence">
        <field name="name">Consentimiento O Dental</field>
        <field name="code">odental.patient.consent</field>
        <field name="prefix">CON/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

