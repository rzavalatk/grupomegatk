<odoo>
  <record id="action_cashflow_plan" model="ir.actions.server">
    <field name="name">Flujo de caja proyectado</field><field name="model_id" ref="model_cashflow_plan"/><field name="state">code</field><field name="code">action = model.action_open_current_plan()</field>
  </record>
  <record id="view_cashflow_plan_form" model="ir.ui.view">
    <field name="name">cashflow.plan.form</field><field name="model">cashflow.plan</field><field name="arch" type="xml">
      <form string="Flujo de caja proyectado"><header><button name="action_refresh_open_items" type="object" string="Actualizar partidas saldadas" class="oe_highlight"/><button name="action_refresh_portfolio" type="object" string="Actualizar detalle de cartera"/><button name="action_print_portfolio" type="object" string="Imprimir detalle de cartera"/></header><sheet>
        <group><field name="company_id" groups="base.group_multi_company"/><field name="currency_id" invisible="1"/></group>
        <group string="Resumen"><field name="total_real_available" readonly="1"/><field name="total_expected_receivable" readonly="1"/><field name="total_expected_payable" readonly="1"/><field name="projected_balance" readonly="1"/></group>
        <group string="Cobros esperados por período"><field name="receivable_week_1" readonly="1"/><field name="receivable_week_2" readonly="1"/><field name="receivable_week_3" readonly="1"/><field name="receivable_pending" readonly="1"/></group>
        <group string="Pagos programados por período"><field name="payable_week_1" readonly="1"/><field name="payable_week_2" readonly="1"/><field name="payable_week_3" readonly="1"/><field name="payable_pending" readonly="1"/></group>
        <group string="Saldo acumulado proyectado"><field name="projected_week_1" readonly="1"/><field name="projected_week_2" readonly="1"/><field name="projected_week_3" readonly="1"/><field name="projected_pending" readonly="1"/></group>
        <notebook>
          <page string="Disponible"><group><div class="o_form_label">El saldo contable viene de Odoo y no se modifica. El disponible real se usa únicamente para la proyección.</div></group><field name="bank_position_ids"><list editable="bottom"><field name="journal_id"/><field name="account_id" optional="show"/><field name="accounting_balance" readonly="1"/><field name="real_balance"/><field name="balance_difference" readonly="1"/></list></field></page>
          <page string="Cobros proyectados">
            <field name="promise_ids" domain="[('direction', '=', 'receivable')]" context="{'default_direction': 'receivable'}">
              <list editable="bottom" decoration-muted="state == 'cancelled'">
                <field name="company_id" invisible="1"/><field name="commercial_partner_id" invisible="1"/><field name="direction" invisible="1"/>
                <field name="partner_id"/><field name="classification_id" optional="show"/><field name="source_move_id" optional="show"/>
                <field name="current_open_balance" readonly="1"/><field name="amount" string="Cobro esperado"/><field name="projected_remaining_balance" readonly="1"/>
                <field name="period" widget="badge" decoration-success="period"/><field name="note" readonly="1" optional="show"/><field name="state"/>
                <button name="action_add_management_note" type="object" string="Registrar gestión" class="btn-link"/>
                <button name="action_open_management_history" type="object" string="Historial" class="btn-link"/>
              </list>
            </field>
          </page>
          <page string="Pagos a proveedores">
            <field name="promise_ids" domain="[('direction', '=', 'payable')]" context="{'default_direction': 'payable'}">
              <list editable="bottom" decoration-muted="state == 'cancelled'">
                <field name="company_id" invisible="1"/><field name="commercial_partner_id" invisible="1"/><field name="direction" invisible="1"/>
                <field name="partner_id"/><field name="classification_id" optional="show"/><field name="source_move_id" optional="show"/>
                <field name="current_open_balance" readonly="1"/><field name="amount" string="Pago programado"/><field name="projected_remaining_balance" readonly="1"/>
                <field name="period" widget="badge" decoration-danger="period"/><field name="state"/>
              </list>
            </field>
          </page>
          <page string="Egresos manuales y recurrentes"><field name="manual_expense_ids"><list editable="bottom"><field name="name"/><field name="classification"/><field name="period" widget="badge" decoration-danger="active"/><field name="currency_id"/><field name="amount"/><field name="rate_date" optional="show"/><field name="company_amount" readonly="1"/><field name="recurring" string="Recurrente"/><field name="active"/></list></field></page>
        </notebook>
      </sheet><chatter/></form>
    </field>
  </record>
  <record id="view_cashflow_plan_list" model="ir.ui.view"><field name="name">cashflow.plan.list</field><field name="model">cashflow.plan</field><field name="arch" type="xml"><list><field name="company_id"/><field name="total_real_available"/><field name="total_expected_receivable"/><field name="total_expected_payable"/><field name="projected_balance"/></list></field></record>
  <record id="view_cashflow_promise_form" model="ir.ui.view"><field name="name">cashflow.promise.form</field><field name="model">cashflow.promise</field><field name="arch" type="xml"><form string="Cobro o pago proyectado"><header><button name="action_add_management_note" type="object" string="Registrar gestión" class="oe_highlight" invisible="direction != 'receivable'"/><button name="action_open_management_history" type="object" string="Ver historial" invisible="direction != 'receivable'"/><button name="action_cancel" type="object" string="Retirar de la proyección" invisible="state == 'cancelled'"/></header><sheet><group><field name="plan_id"/><field name="company_id" invisible="1"/><field name="commercial_partner_id" invisible="1"/><field name="partner_id"/><field name="direction"/><field name="classification_id"/><field name="source_move_id"/><field name="current_open_balance" readonly="1"/><field name="source_residual" readonly="1" invisible="not source_move_id"/><field name="period"/><field name="amount"/><field name="projected_remaining_balance" readonly="1"/><field name="note" readonly="1"/><field name="state"/></group></sheet><chatter/></form></field></record>
  <record id="view_cashflow_promise_list" model="ir.ui.view"><field name="name">cashflow.promise.list</field><field name="model">cashflow.promise</field><field name="arch" type="xml"><list decoration-muted="state == 'cancelled'"><field name="company_id" invisible="1"/><field name="commercial_partner_id" invisible="1"/><field name="partner_id"/><field name="direction"/><field name="classification_id" optional="show"/><field name="source_move_id" optional="show"/><field name="current_open_balance" readonly="1"/><field name="amount"/><field name="projected_remaining_balance" readonly="1"/><field name="period" widget="badge" decoration-success="direction == 'receivable'" decoration-danger="direction == 'payable'"/><field name="note" readonly="1" optional="show"/><field name="state"/><button name="action_add_management_note" type="object" string="Registrar gestión" class="btn-link" invisible="direction != 'receivable'"/><button name="action_open_management_history" type="object" string="Historial" class="btn-link" invisible="direction != 'receivable'"/><button name="action_cancel" type="object" string="Retirar" class="btn-link" invisible="state == 'cancelled'"/></list></field></record>
  <record id="action_cashflow_receivable_promises" model="ir.actions.act_window"><field name="name">Cobros esperados</field><field name="res_model">cashflow.promise</field><field name="view_mode">list,form</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0]), ('direction', '=', 'receivable')]</field><field name="context">{'default_direction': 'receivable', 'search_default_active': 1}</field></record>
  <record id="action_cashflow_payable_promises" model="ir.actions.act_window"><field name="name">Pagos programados</field><field name="res_model">cashflow.promise</field><field name="view_mode">list,form</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0]), ('direction', '=', 'payable')]</field><field name="context">{'default_direction': 'payable', 'search_default_active': 1}</field></record>
  <record id="view_cashflow_promise_search" model="ir.ui.view"><field name="name">cashflow.promise.search</field><field name="model">cashflow.promise</field><field name="arch" type="xml"><search><field name="partner_id"/><field name="period"/><filter string="Activos" name="active" domain="[('state','=','active')]"/><filter string="Semana 1" name="week_1" domain="[('period','=','week_1')]"/><filter string="Semana 2" name="week_2" domain="[('period','=','week_2')]"/><filter string="Semana 3" name="week_3" domain="[('period','=','week_3')]"/><filter string="Pendientes" name="pending" domain="[('period','=','pending')]"/></search></field></record>
  <record id="view_cashflow_manual_expense_list" model="ir.ui.view"><field name="name">cashflow.manual.expense.list</field><field name="model">cashflow.manual.expense</field><field name="arch" type="xml"><list editable="bottom" decoration-muted="not active"><field name="company_id" groups="base.group_multi_company" readonly="1"/><field name="name"/><field name="classification"/><field name="period" widget="badge" decoration-danger="active"/><field name="currency_id"/><field name="amount"/><field name="rate_date"/><field name="company_amount" readonly="1"/><field name="recurring"/><field name="active"/></list></field></record>
  <record id="view_cashflow_manual_expense_form" model="ir.ui.view"><field name="name">cashflow.manual.expense.form</field><field name="model">cashflow.manual.expense</field><field name="arch" type="xml"><form string="Egreso manual proyectado"><sheet><group><field name="plan_id"/><field name="name"/><field name="classification"/><field name="period"/><field name="currency_id"/><field name="amount"/><field name="rate_date"/><field name="company_amount" readonly="1"/><field name="recurring"/><field name="active"/></group></sheet><chatter/></form></field></record>
  <record id="action_cashflow_manual_expense" model="ir.actions.act_window"><field name="name">Egresos manuales y recurrentes</field><field name="res_model">cashflow.manual.expense</field><field name="view_mode">list,form</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0])]</field></record>
  <record id="view_cashflow_snapshot_list" model="ir.ui.view"><field name="name">cashflow.portfolio.snapshot.list</field><field name="model">cashflow.portfolio.snapshot</field><field name="arch" type="xml"><list create="0" delete="0" editable="bottom"><header><button name="action_refresh_current_company" type="object" string="Actualizar cartera desde Odoo" display="always" class="btn-primary"/><button name="action_print_current_company" type="object" string="Imprimir / guardar PDF" display="always"/></header><field name="partner_id" readonly="1"/><field name="open_document_count" string="Documentos" readonly="1" optional="show"/><field name="projected_periods" string="Semanas" widget="badge" decoration-success="direction == 'receivable' and projected_periods" decoration-danger="direction == 'payable' and projected_periods" readonly="1" optional="show"/><field name="direction" readonly="1"/><field name="classification"/><field name="at_day" decoration-success="at_day != 0" readonly="1"/><field name="days_1_30" decoration-warning="days_1_30 != 0" readonly="1"/><field name="days_31_60" decoration-danger="days_31_60 != 0" readonly="1"/><field name="days_61_90" decoration-danger="days_61_90 != 0" readonly="1"/><field name="days_91_120" decoration-danger="days_91_120 != 0" readonly="1"/><field name="old" decoration-danger="old != 0" readonly="1"/><field name="credit" decoration-info="credit != 0" readonly="1"/><field name="total" readonly="1"/><field name="last_management" string="Última gestión" readonly="1" optional="show"/><field name="next_action_date" readonly="1" optional="show"/><button name="action_open_documents" type="object" string="Ver documentos" class="btn-link"/><button name="action_refresh_partner" type="object" string="Actualizar cliente" class="btn-link"/><button name="action_schedule_promise" type="object" string="Programar" class="btn-link" groups="megatk_cash_flow_forecast.group_cashflow_user"/><button name="action_add_management_note" type="object" string="Registrar gestión" class="btn-link" invisible="direction != 'receivable'"/><button name="action_open_management_history" type="object" string="Historial" class="btn-link" invisible="direction != 'receivable'"/><field name="last_management_at" readonly="1" optional="hide"/><field name="refreshed_at" readonly="1" optional="hide"/></list></field></record>
  <record id="view_cashflow_snapshot_search" model="ir.ui.view"><field name="name">cashflow.portfolio.snapshot.search</field><field name="model">cashflow.portfolio.snapshot</field><field name="arch" type="xml"><search><field name="partner_id"/><filter string="Cuentas por cobrar" name="receivable" domain="[('direction','=','receivable')]"/><filter string="Cuentas por pagar" name="payable" domain="[('direction','=','payable')]"/><separator/><filter string="Al día" name="at_day" domain="[('at_day','!=',0)]"/><filter string="1–30 días" name="days_1_30" domain="[('days_1_30','!=',0)]"/><filter string="31–60 días" name="days_31_60" domain="[('days_31_60','!=',0)]"/><filter string="61–90 días" name="days_61_90" domain="[('days_61_90','!=',0)]"/><filter string="Más de 90 días" name="over_90" domain="['|',('days_91_120','!=',0),('old','!=',0)]"/><filter string="Créditos / anticipos" name="credits" domain="[('credit','!=',0)]"/><separator/><filter string="Clientes" name="customer" domain="[('classification','=','customer')]"/><filter string="CxC empleados" name="employee_receivable" domain="[('classification','=','employee_receivable')]"/><filter string="Grupo Mega" name="group_receivable" domain="[('classification','=','group_receivable')]"/><filter string="Proveedores" name="supplier" domain="[('classification','=','supplier')]"/><filter string="Acreedores" name="creditor" domain="[('classification','=','creditor')]"/><filter string="Anticipos" name="advance" domain="[('classification','=','advance')]"/><filter string="En legal" name="legal" domain="[('classification','=','legal')]"/><filter string="Por depurar" name="to_reconcile" domain="[('classification','=','to_reconcile')]"/><filter string="Por asignar" name="unassigned" domain="[('classification','=','unassigned')]"/></search></field></record>
  <record id="action_cashflow_snapshot" model="ir.actions.act_window"><field name="name">Detalle de cartera</field><field name="res_model">cashflow.portfolio.snapshot</field><field name="view_mode">list</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0])]</field></record>
  <record id="action_cashflow_classification" model="ir.actions.act_window"><field name="name">Clasificación de cartera</field><field name="res_model">cashflow.portfolio.classification</field><field name="view_mode">list,form</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0])]</field></record>
  <record id="view_cashflow_classification_list" model="ir.ui.view"><field name="name">cashflow.portfolio.classification.list</field><field name="model">cashflow.portfolio.classification</field><field name="arch" type="xml"><list editable="bottom"><field name="company_id" groups="base.group_multi_company"/><field name="partner_id"/><field name="direction"/><field name="classification"/></list></field></record>
  <record id="view_cashflow_management_note_list" model="ir.ui.view"><field name="name">cashflow.management.note.list</field><field name="model">cashflow.management.note</field><field name="arch" type="xml"><list decoration-danger="follow_up_status == 'overdue'" decoration-warning="follow_up_status == 'today'"><field name="create_date" string="Fecha"/><field name="partner_id"/><field name="move_id" optional="show"/><field name="management_type"/><field name="promise_id" optional="hide"/><field name="note"/><field name="next_action_date"/><field name="follow_up_status"/><field name="author_id"/></list></field></record>
  <record id="view_cashflow_management_note_form" model="ir.ui.view"><field name="name">cashflow.management.note.form</field><field name="model">cashflow.management.note</field><field name="arch" type="xml"><form string="Registrar gestión de cobranza"><sheet><group><field name="company_id" invisible="1"/><field name="partner_id"/><field name="move_id"/><field name="management_type"/><field name="promise_id"/><field name="note" placeholder="Ej.: Se llamó al cliente; confirmó pago para la Semana 2."/><field name="next_action_date"/><field name="author_id"/></group></sheet></form></field></record>
  <record id="view_cashflow_management_note_search" model="ir.ui.view"><field name="name">cashflow.management.note.search</field><field name="model">cashflow.management.note</field><field name="arch" type="xml"><search><field name="partner_id"/><field name="author_id"/><filter string="Hoy" name="today" domain="[('next_action_date', '=', context_today().strftime('%Y-%m-%d'))]"/><filter string="Pendientes" name="pending" domain="[('next_action_date', '!=', False)]"/><group expand="0" string="Agrupar por"><filter string="Cliente" name="partner" context="{'group_by':'partner_id'}"/><filter string="Responsable" name="author" context="{'group_by':'author_id'}"/><filter string="Próxima gestión" name="next_action" context="{'group_by':'next_action_date'}"/></group></search></field></record>
  <record id="action_cashflow_snapshot_receivable" model="ir.actions.act_window"><field name="name">Detalle de cuentas por cobrar</field><field name="res_model">cashflow.portfolio.snapshot</field><field name="view_mode">list</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0]), ('direction', '=', 'receivable')]</field><field name="context">{'cashflow_report_direction': 'receivable'}</field></record>
  <record id="action_cashflow_snapshot_payable" model="ir.actions.act_window"><field name="name">Detalle de cuentas por pagar</field><field name="res_model">cashflow.portfolio.snapshot</field><field name="view_mode">list</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0]), ('direction', '=', 'payable')]</field><field name="context">{'cashflow_report_direction': 'payable'}</field></record>
  <record id="action_cashflow_management_note" model="ir.actions.act_window"><field name="name">Historial de gestiones</field><field name="res_model">cashflow.management.note</field><field name="view_mode">list,form</field><field name="domain">[('company_id', '=', context.get('allowed_company_ids', [False])[0])]</field></record>
  <menuitem id="menu_cashflow_root" name="Flujo de caja proyectado" sequence="50" web_icon="megatk_cash_flow_forecast,static/description/icon.png" groups="megatk_cash_flow_forecast.group_cashflow_user,megatk_cash_flow_forecast.group_cashflow_collections"/>
  <menuitem id="menu_cashflow_plan" name="Proyección" parent="menu_cashflow_root" action="action_cashflow_plan" sequence="10" groups="megatk_cash_flow_forecast.group_cashflow_user"/>
  <menuitem id="menu_cashflow_snapshot" name="Detalle de cartera" parent="menu_cashflow_root" action="action_cashflow_snapshot" sequence="15" groups="megatk_cash_flow_forecast.group_cashflow_user"/>
  <menuitem id="menu_cashflow_receivable_promises" name="Cobros esperados" parent="menu_cashflow_root" action="action_cashflow_receivable_promises" sequence="17" groups="megatk_cash_flow_forecast.group_cashflow_user,megatk_cash_flow_forecast.group_cashflow_collections"/>
  <menuitem id="menu_cashflow_payable_promises" name="Pagos programados" parent="menu_cashflow_root" action="action_cashflow_payable_promises" sequence="18" groups="megatk_cash_flow_forecast.group_cashflow_user"/>
  <menuitem id="menu_cashflow_manual_expense" name="Egresos manuales y recurrentes" parent="menu_cashflow_root" action="action_cashflow_manual_expense" sequence="19" groups="megatk_cash_flow_forecast.group_cashflow_user"/>
  <menuitem id="menu_cashflow_collections" name="Gestión de cuentas por cobrar" parent="menu_cashflow_root" action="action_cashflow_snapshot_receivable" sequence="20" groups="megatk_cash_flow_forecast.group_cashflow_user,megatk_cash_flow_forecast.group_cashflow_collections"/>
  <menuitem id="menu_cashflow_payables" name="Programación de cuentas por pagar" parent="menu_cashflow_root" action="action_cashflow_snapshot_payable" sequence="21" groups="megatk_cash_flow_forecast.group_cashflow_user"/>
  <menuitem id="menu_cashflow_management_note" name="Historial de cobros" parent="menu_cashflow_root" action="action_cashflow_management_note" sequence="25" groups="megatk_cash_flow_forecast.group_cashflow_user,megatk_cash_flow_forecast.group_cashflow_collections"/>
  <menuitem id="menu_cashflow_classification" name="Clasificaciones" parent="menu_cashflow_root" action="action_cashflow_classification" sequence="30" groups="megatk_cash_flow_forecast.group_cashflow_manager"/>
</odoo>
