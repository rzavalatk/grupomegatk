<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="megatk_cash_flow_forecast.CashflowAgedPartnerLineName"
     t-inherit="account_reports.AccountReportLineNameCustomizable"
     t-inherit-mode="primary">
    <xpath expr="//t[@data-id='line_buttons']" position="replace">
      <t data-id="line_buttons">
        <span t-if="isCashflowPartnerLine" class="cashflow-aged-actions ms-2">
          <button class="btn btn-link btn-sm" t-on-click.stop="() => this.cashflowAction('documents')">Ver documentos</button>
          <button class="btn btn-link btn-sm" t-on-click.stop="() => this.cashflowAction('schedule')">Programar</button>
          <button class="btn btn-link btn-sm" t-on-click.stop="() => this.cashflowAction('management')">Registrar gestión</button>
          <button class="btn btn-link btn-sm" t-on-click.stop="() => this.cashflowAction('history')">Historial</button>
        </span>
      </t>
    </xpath>
  </t>
</templates>
