<odoo>
  <record id="module_category_cashflow" model="ir.module.category"><field name="name">Flujo de caja proyectado</field><field name="sequence">40</field></record>
  <record id="group_cashflow_user" model="res.groups"><field name="name">Usuario</field><field name="category_id" ref="module_category_cashflow"/></record>
  <record id="group_cashflow_collections" model="res.groups"><field name="name">Gestor de cobros</field><field name="category_id" ref="module_category_cashflow"/><field name="comment">Puede consultar cuentas por cobrar y registrar el historial de gestiones.</field></record>
  <record id="group_cashflow_manager" model="res.groups"><field name="name">Administrador</field><field name="category_id" ref="module_category_cashflow"/><field name="implied_ids" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_plan_company" model="ir.rule"><field name="name">Flujo proyectado por empresa</field><field name="model_id" ref="model_cashflow_plan"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_bank_company" model="ir.rule"><field name="name">Bancos del flujo por empresa</field><field name="model_id" ref="model_cashflow_bank_position"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_promise_company" model="ir.rule"><field name="name">Promesas por empresa</field><field name="model_id" ref="model_cashflow_promise"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_classification_company" model="ir.rule"><field name="name">Clasificaciones por empresa</field><field name="model_id" ref="model_cashflow_portfolio_classification"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_manual_income_company" model="ir.rule"><field name="name">Otros ingresos por empresa</field><field name="model_id" ref="model_cashflow_manual_income"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_manual_expense_company" model="ir.rule"><field name="name">Egresos manuales por empresa</field><field name="model_id" ref="model_cashflow_manual_expense"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_snapshot_company" model="ir.rule"><field name="name">Cartera proyectada por empresa</field><field name="model_id" ref="model_cashflow_portfolio_snapshot"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_note_company" model="ir.rule"><field name="name">Historial de cobros por empresa</field><field name="model_id" ref="model_cashflow_management_note"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_user'))]"/></record>
  <record id="rule_cashflow_promise_collections" model="ir.rule"><field name="name">Cobros visibles para gestores</field><field name="model_id" ref="model_cashflow_promise"/><field name="domain_force">[('company_id', 'in', company_ids), ('direction', '=', 'receivable')]</field><field name="groups" eval="[(4, ref('group_cashflow_collections'))]"/></record>
  <record id="rule_cashflow_snapshot_collections" model="ir.rule"><field name="name">CxC visible para gestores</field><field name="model_id" ref="model_cashflow_portfolio_snapshot"/><field name="domain_force">[('company_id', 'in', company_ids), ('direction', '=', 'receivable')]</field><field name="groups" eval="[(4, ref('group_cashflow_collections'))]"/></record>
  <record id="rule_cashflow_note_collections" model="ir.rule"><field name="name">Gestiones de cobranza por empresa</field><field name="model_id" ref="model_cashflow_management_note"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cashflow_collections'))]"/></record>
  <record id="rule_cashflow_classification_collections" model="ir.rule"><field name="name">Clasificación de CxC para gestores</field><field name="model_id" ref="model_cashflow_portfolio_classification"/><field name="domain_force">[('company_id', 'in', company_ids), ('direction', '=', 'receivable')]</field><field name="groups" eval="[(4, ref('group_cashflow_collections'))]"/></record>
</odoo>
