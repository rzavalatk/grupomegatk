<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_consumption_list" model="ir.ui.view"><field name="name">odental.material.consumption.list</field><field name="model">odental.material.consumption</field><field name="arch" type="xml"><list decoration-success="state == 'posted'" decoration-warning="state == 'draft'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="consumption_date"/><field name="patient_id"/><field name="professional_id"/><field name="service_id"/><field name="organization_id"/><field name="picking_id"/><field name="state"/></list></field></record>
    <record id="view_material_consumption_form" model="ir.ui.view"><field name="name">odental.material.consumption.form</field><field name="model">odental.material.consumption</field><field name="arch" type="xml"><form><header><button name="action_prepare_materials" type="object" string="Actualizar protocolo" invisible="state != 'draft'"/><button name="action_ready" type="object" string="Confirmar materiales" class="btn-primary" invisible="state != 'draft'"/><button name="action_create_picking" type="object" string="Crear transferencia" class="btn-primary" invisible="state != 'ready'"/><button name="action_mark_posted" type="object" string="Verificar descuento" class="btn-primary" invisible="state != 'allocated'"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('posted', 'cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,allocated,posted"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not picking_id"><field name="picking_id" string="Transferencia" widget="statinfo"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="appointment_id"/><field name="patient_id"/><field name="professional_id"/><field name="service_id"/></group><group><field name="organization_id"/><field name="consumption_date"/><field name="picking_id" readonly="1"/></group></group><field name="line_ids" readonly="state in ('allocated', 'posted', 'cancelled')"><list editable="bottom"><field name="product_id"/><field name="quantity_planned"/><field name="quantity_used"/><field name="product_uom_id"/><field name="lot_id"/><field name="mandatory"/><field name="notes" optional="hide"/></list></field><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_material_consumption" model="ir.actions.act_window"><field name="name">Consumos clínicos</field><field name="res_model">odental.material.consumption</field><field name="view_mode">list,form</field></record>
</odoo>

