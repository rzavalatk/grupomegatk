<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_odental_treatment_plan_member" model="ir.rule">
        <field name="name">O Dental: planes de tratamiento autorizados</field>
        <field name="model_id" ref="model_odental_treatment_plan"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_professional'))]"/>
        <field name="domain_force">['|', ('organization_id.owner_user_id', '=', user.id), ('organization_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_odental_treatment_line_member" model="ir.rule">
        <field name="name">O Dental: procedimientos autorizados</field>
        <field name="model_id" ref="model_odental_treatment_plan_line"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_professional'))]"/>
        <field name="domain_force">['|', ('organization_id.owner_user_id', '=', user.id), ('organization_id.user_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_odental_treatment_plan_admin" model="ir.rule">
        <field name="name">O Dental: administración global de planes</field>
        <field name="model_id" ref="model_odental_treatment_plan"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_odental_treatment_line_admin" model="ir.rule">
        <field name="name">O Dental: administración global de procedimientos</field>
        <field name="model_id" ref="model_odental_treatment_plan_line"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
