<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_event_list" model="ir.ui.view">
        <field name="name">odental.whatsapp.event.list</field>
        <field name="model">odental.whatsapp.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="state == 'processed'" decoration-warning="state == 'ignored'" decoration-danger="state == 'failed'">
                <field name="received_at"/><field name="account_id"/><field name="event_type"/>
                <field name="wa_id"/><field name="message_kind"/><field name="provider_message_id"/>
                <field name="state"/><field name="request_id"/>
            </list>
        </field>
    </record>
    <record id="view_whatsapp_event_form" model="ir.ui.view">
        <field name="name">odental.whatsapp.event.form</field>
        <field name="model">odental.whatsapp.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"><sheet>
                <group><group><field name="received_at"/><field name="account_id"/><field name="event_type"/><field name="state"/></group>
                <group><field name="provider_message_id"/><field name="wa_id"/><field name="message_kind"/><field name="request_id"/></group></group>
                <group><field name="text_preview"/><field name="processing_note"/><field name="payload_digest"/></group>
            </sheet></form>
        </field>
    </record>
    <record id="action_whatsapp_event" model="ir.actions.act_window">
        <field name="name">Eventos WhatsApp</field><field name="res_model">odental.whatsapp.event</field>
        <field name="view_mode">list,form</field><field name="context">{'create': False}</field>
    </record>
</odoo>

