<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_credentials_wizard_form" model="ir.ui.view">
        <field name="name">odental.whatsapp.credentials.wizard.form</field>
        <field name="model">odental.whatsapp.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="Credenciales WhatsApp">
                <group><field name="account_id"/><field name="access_token" password="True"/>
                    <field name="app_secret" password="True"/><field name="verify_token" password="True"/>
                </group>
                <div class="alert alert-info" role="alert">Los campos vacíos conservan el valor anterior. El token de verificación se guarda únicamente como resumen criptográfico.</div>
                <footer><button name="action_save" type="object" string="Guardar credenciales" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>

