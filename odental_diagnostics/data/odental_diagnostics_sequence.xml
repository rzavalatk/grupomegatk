<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_odental_odontogram" model="ir.sequence">
        <field name="name">Odontograma O Dental</field>
        <field name="code">odental.odontogram</field>
        <field name="prefix">ODO/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_odental_clinical_image" model="ir.sequence">
        <field name="name">Imagen clínica O Dental</field>
        <field name="code">odental.clinical.image</field>
        <field name="prefix">IMG/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

