<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lenka_statement" model="ir.actions.report">
        <field name="name">Estado de Cuenta Lenka</field>
        <field name="model">lenka.statement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lenka_financiero.report_lenka_statement_document</field>
        <field name="report_file">lenka_financiero.report_lenka_statement_document</field>
        <field name="binding_model_id" ref="model_lenka_statement"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Estado de Cuenta - %s' % (object.name)</field>
    </record>

    <template id="report_lenka_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Estado de Cuenta - Inversiones Lenka</h2>
                        <p><strong>Estado de cuenta:</strong> <span t-field="o.name"/></p>
                        <p><strong>Cliente:</strong> <span t-field="o.partner_id"/></p>
                        <p><strong>Periodo:</strong> <span t-field="o.date_from"/> al <span t-field="o.date_to"/></p>
                        <p><strong>Moneda:</strong> <span t-field="o.currency_id"/></p>
                        <table t-if="o.statement_type == 'operation'" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fecha</th><th>Descripcion</th><th>Referencia</th>
                                    <th class="text-end">Capital</th><th class="text-end">Interes</th>
                                    <th class="text-end">Mora</th><th class="text-end">Cargos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-field="l.date"/></td>
                                    <td><span t-field="l.description"/></td>
                                    <td><span t-field="l.reference"/></td>
                                    <td class="text-end"><span t-field="l.capital"/></td>
                                    <td class="text-end"><span t-field="l.interest"/></td>
                                    <td class="text-end"><span t-field="l.late_fee"/></td>
                                    <td class="text-end"><span t-field="l.fee"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table t-if="o.statement_type == 'investment'" name="investment_movements" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fecha</th><th>Descripción</th><th>Referencia</th>
                                    <th class="text-end">Entradas</th><th class="text-end">Salidas</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-field="l.date"/></td>
                                    <td><span t-field="l.description"/></td>
                                    <td><span t-field="l.reference"/></td>
                                    <td class="text-end"><span t-field="l.credit"/></td>
                                    <td class="text-end"><span t-field="l.debit"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="o.statement_type == 'investment'">Las entradas incluyen el depósito y los intereses brutos. Las salidas incluyen los retiros y las retenciones. El saldo final corresponde al saldo inicial más entradas menos salidas.</p>
                        <div class="row mt32">
                            <div class="col-6">
                                <p><strong>Saldo inicial:</strong> <span t-field="o.opening_balance"/></p>
                                <p t-if="o.statement_type == 'operation'"><strong>Capital del periodo:</strong> <span t-field="o.period_capital"/></p>
                                <p><strong>Intereses:</strong> <span t-field="o.period_interest"/></p>
                                <p t-if="o.statement_type == 'operation'"><strong>Mora:</strong> <span t-field="o.period_late_fees"/></p>
                                <p t-if="o.statement_type == 'operation'"><strong>Comisiones / cargos:</strong> <span t-field="o.period_fees"/></p>
                                <p><strong>Saldo final:</strong> <span t-field="o.closing_balance"/></p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
