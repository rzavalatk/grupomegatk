<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lenka_funding_cost_list" model="ir.ui.view">
        <field name="name">lenka.funding.cost.list</field>
        <field name="model">lenka.funding.cost</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="operation_id"/>
                <field name="funding_line_id"/>
                <field name="cost_type"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_lenka_funding_cost_form" model="ir.ui.view">
        <field name="name">lenka.funding.cost.form</field>
        <field name="model">lenka.funding.cost</field>
        <field name="arch" type="xml">
            <form string="Costo real de fondeo">
                <header>
                    <button name="action_post" string="Aplicar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Anular" type="object" invisible="state == 'cancelled'"/>
                    <button name="action_create_account_move" string="Crear borrador contable" type="object" invisible="state != 'posted' or move_id"/>
                    <button name="action_open_account_move" string="Abrir borrador contable" type="object" invisible="not move_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="funding_line_id"/>
                            <field name="operation_id" readonly="1"/>
                            <field name="cost_type"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="amount"/>
                            <field name="reference"/>
                            <field name="journal_id"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lenka_funding_costs" model="ir.actions.act_window">
        <field name="name">Costos reales de fondeo</field>
        <field name="res_model">lenka.funding.cost</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="view_lenka_operation_form_funding_cost" model="ir.ui.view">
        <field name="name">lenka.operation.form.funding.cost</field>
        <field name="model">lenka.financial.operation</field>
        <field name="inherit_id" ref="lenka_financiero.view_lenka_operation_form_profitability"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='realized_result']" position="inside">
                <field name="realized_funding_cost" readonly="1"/>
                <field name="realized_net_financial_margin" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='funding']" position="after">
                <page string="Costos reales de fondeo">
                    <field name="funding_cost_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="funding_line_id"/>
                            <field name="cost_type"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="state"/>
                            <field name="move_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
