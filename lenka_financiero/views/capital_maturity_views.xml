<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lenka_disbursement_capital_maturity" model="ir.ui.view">
        <field name="name">lenka.disbursement.capital.maturity</field>
        <field name="model">lenka.disbursement</field>
        <field name="inherit_id" ref="lenka_financiero.view_lenka_disbursement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_open_capital_maturity" string="Definir vencimiento CxC" type="object" invisible="state != 'posted'" groups="lenka_financiero.group_lenka_manager"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="capital_plan_due_date" readonly="1"/>
                <field name="capital_due_date" readonly="move_id or state == 'cancelled' or payment_method == 'refinance_entry'" groups="lenka_financiero.group_lenka_manager"/>
            </xpath>
        </field>
    </record>
    <record id="view_lenka_capital_maturity_wizard" model="ir.ui.view">
        <field name="name">lenka.capital.maturity.wizard.form</field>
        <field name="model">lenka.capital.maturity.wizard</field>
        <field name="arch" type="xml">
            <form string="Definir vencimiento CxC">
                <div class="alert alert-info">Solo cambia la fecha de vencimiento contable del capital de este desembolso. No crea ni revierte partidas, no mueve bancos y no cambia cuotas, intereses ni mora. Para capital pagadero en cuotas, trasladar todo el saldo al final no representa sus vencimientos parciales.</div>
                <group>
                    <field name="disbursement_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="operation_id" readonly="1" options="{'no_open': True}"/>
                    <field name="plan_due_date" readonly="1"/>
                    <field name="due_date"/>
                    <field name="reason" placeholder="Fecha pactada y referencia del contrato que la respalda"/>
                    <field name="confirmed"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar vencimiento" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
