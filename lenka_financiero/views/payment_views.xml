<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lenka_payment_list" model="ir.ui.view">
        <field name="name">lenka.payment.list</field>
        <field name="model">lenka.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="operation_id"/>
                <field name="amount"/>
                <field name="payment_method"/>
                <field name="collection_destination" optional="show"/>
                <field name="collection_journal_id" optional="show"/>
                <field name="collection_accounting_state" optional="show"/>
                <field name="card_fee_amount"/>
                <field name="net_bank_amount"/>
                <field name="capital_amount"/>
                <field name="interest_amount"/>
                <field name="late_fee_amount"/>
                <field name="unapplied_amount"/>
                <field name="move_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_lenka_payment_form" model="ir.ui.view">
        <field name="name">lenka.payment.form</field>
        <field name="model">lenka.payment</field>
        <field name="arch" type="xml">
            <form string="Cobro Lenka">
                <header>
                    <button name="action_apply_and_prepare_collection" string="Aplicar y crear borrador contable" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_prepare_collection" string="Crear borrador contable" type="object" class="btn-primary" invisible="state != 'posted' or move_id" groups="lenka_financiero.group_lenka_manager"/>
                    <button name="action_open_account_move" string="Ver partida contable" type="object" invisible="not move_id"/>
                    <button name="action_cancel" string="Anular" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">La forma de pago no elige la cuenta receptora. Seleccione Banco, Caja o Intercambio interno y el diario de esta transaccion. Aplicar y crear borrador contable distribuye el pago una sola vez y prepara la partida. El saldo contable del banco cambia al publicar la partida en Contabilidad. Si el ingreso ya tiene un asiento registrado, no cree otro: revise la vinculacion con Contabilidad.</div>
                    <div class="alert alert-warning" role="status" invisible="state != 'posted' or move_id">Este cobro esta aplicado a la deuda, pero aun no tiene partida vinculada. No registre otro pago para contabilizarlo. Revise si ya existe un asiento antes de preparar su contabilidad.</div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="operation_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payment_method" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="collection_bridge_journal_id" invisible="1"/>
                            <field name="collection_destination" required="state == 'draft'" readonly="move_id or state == 'cancelled'"/>
                            <field name="collection_journal_id" required="state == 'draft'" readonly="move_id or state == 'cancelled'" domain="[('company_id', '=', company_id)] + (['|', ('type', '=', 'general'), ('id', '=', collection_bridge_journal_id)] if collection_destination == 'clearing' else [('type', '=', collection_destination or 'bank')])" options="{'no_create': True, 'no_open': True}"/>
                            <field name="collection_account_id"/>
                            <field name="collection_accounting_state"/>
                            <field name="card_fee_rate" invisible="payment_method != 'card'" readonly="state != 'draft'"/>
                            <field name="card_fee_amount" readonly="1" invisible="payment_method != 'card'"/>
                            <field name="net_bank_amount" readonly="1"/>
                            <field name="reference"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Aplicacion del pago" invisible="state == 'draft'">
                        <field name="late_fee_amount"/>
                        <field name="interest_amount"/>
                        <field name="capital_amount"/>
                        <field name="extra_capital_amount"/>
                        <field name="unapplied_amount"/>
                    </group>
                    <notebook>
                        <page string="Detalle aplicado">
                            <field name="allocation_line_ids" readonly="1">
                                <list>
                                    <field name="schedule_line_id"/>
                                    <field name="late_fee_amount"/>
                                    <field name="interest_amount"/>
                                    <field name="capital_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lenka_payments" model="ir.actions.act_window">
        <field name="name">Cobros</field>
        <field name="res_model">lenka.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_lenka_operation_form_collections" model="ir.ui.view">
        <field name="name">lenka.financial.operation.form.collections</field>
        <field name="model">lenka.financial.operation</field>
        <field name="inherit_id" ref="lenka_financiero.view_lenka_operation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cobros">
                    <group>
                        <group>
                            <field name="paid_capital" readonly="1"/>
                            <field name="outstanding_capital" readonly="1"/>
                            <field name="transferred_capital" readonly="1" invisible="not transferred_capital"/>
                            <field name="net_collections" readonly="1"/>
                        </group>
                        <group>
                            <field name="paid_interest" readonly="1"/>
                            <field name="paid_late_fees" readonly="1"/>
                            <field name="paid_card_fees" readonly="1"/>
                            <field name="late_fee_rate" readonly="state not in ('draft', 'review', 'rejected') or sole_signature_status in ('pending', 'approved')"/>
                            <field name="grace_days" readonly="state not in ('draft', 'review', 'rejected') or sole_signature_status in ('pending', 'approved')"/>
                        </group>
                    </group>
                    <button name="action_update_late_fees" string="Actualizar mora" type="object"/>
                    <field name="payment_ids" context="{'default_operation_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="payment_date"/>
                            <field name="amount"/>
                            <field name="net_bank_amount"/>
                            <field name="capital_amount"/>
                            <field name="interest_amount"/>
                            <field name="late_fee_amount"/>
                            <field name="collection_journal_id" optional="show"/>
                            <field name="collection_accounting_state" optional="show"/>
                            <field name="move_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='schedule_line_ids']/list/field[@name='closing_balance']" position="after">
                <field name="capital_paid"/>
                <field name="interest_paid"/>
                <field name="late_fee_due"/>
                <field name="amount_due"/>
                <field name="payment_state"/>
            </xpath>
        </field>
    </record>
</odoo>

