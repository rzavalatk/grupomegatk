<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lenka_payment_list" model="ir.ui.view">
        <field name="name">lenka.payment.list</field>
        <field name="model">lenka.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="operation_id"/>
                <field name="amount"/>
                <field name="payment_method"/>
                <field name="card_fee_amount"/>
                <field name="net_bank_amount"/>
                <field name="capital_amount"/>
                <field name="interest_amount"/>
                <field name="late_fee_amount"/>
                <field name="unapplied_amount"/>
                <field name="move_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_lenka_payment_form" model="ir.ui.view">
        <field name="name">lenka.payment.form</field>
        <field name="model">lenka.payment</field>
        <field name="arch" type="xml">
            <form string="Cobro Lenka">
                <header>
                    <button name="action_post" string="Aplicar pago" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_account_move" string="Crear borrador contable" type="object" class="btn-primary" invisible="state != 'posted' or move_id" groups="lenka_financiero.group_lenka_manager"/>
                    <button name="action_open_account_move" string="Ver borrador contable" type="object" invisible="not move_id"/>
                    <button name="action_cancel" string="Anular" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="operation_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payment_method" readonly="state != 'draft'"/>
                            <field name="card_fee_rate" invisible="payment_method != 'card'" readonly="state != 'draft'"/>
                            <field name="card_fee_amount" readonly="1" invisible="payment_method != 'card'"/>
                            <field name="net_bank_amount" readonly="1"/>
                            <field name="reference"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Aplicacion del pago" invisible="state == 'draft'">
                        <field name="late_fee_amount"/>
                        <field name="interest_amount"/>
                        <field name="capital_amount"/>
                        <field name="extra_capital_amount"/>
                        <field name="unapplied_amount"/>
                    </group>
                    <notebook>
                        <page string="Detalle aplicado">
                            <field name="allocation_line_ids" readonly="1">
                                <list>
                                    <field name="schedule_line_id"/>
                                    <field name="late_fee_amount"/>
                                    <field name="interest_amount"/>
                                    <field name="capital_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lenka_payments" model="ir.actions.act_window">
        <field name="name">Cobros</field>
        <field name="res_model">lenka.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_lenka_operation_form_collections" model="ir.ui.view">
        <field name="name">lenka.financial.operation.form.collections</field>
        <field name="model">lenka.financial.operation</field>
        <field name="inherit_id" ref="lenka_financiero.view_lenka_operation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cobros">
                    <group>
                        <group>
                            <field name="paid_capital" readonly="1"/>
                            <field name="outstanding_capital" readonly="1"/>
                            <field name="transferred_capital" readonly="1" invisible="not transferred_capital"/>
                            <field name="net_collections" readonly="1"/>
                        </group>
                        <group>
                            <field name="paid_interest" readonly="1"/>
                            <field name="paid_late_fees" readonly="1"/>
                            <field name="paid_card_fees" readonly="1"/>
                            <field name="late_fee_rate"/>
                            <field name="grace_days"/>
                        </group>
                    </group>
                    <button name="action_update_late_fees" string="Actualizar mora" type="object"/>
                    <field name="payment_ids" context="{'default_operation_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="payment_date"/>
                            <field name="amount"/>
                            <field name="net_bank_amount"/>
                            <field name="capital_amount"/>
                            <field name="interest_amount"/>
                            <field name="late_fee_amount"/>
                            <field name="move_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='schedule_line_ids']/list/field[@name='closing_balance']" position="after">
                <field name="capital_paid"/>
                <field name="interest_paid"/>
                <field name="late_fee_due"/>
                <field name="amount_due"/>
                <field name="payment_state"/>
            </xpath>
        </field>
    </record>
</odoo>
