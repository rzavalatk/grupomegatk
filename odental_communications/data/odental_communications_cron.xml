<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_odental_prepare_reminders" model="ir.cron">
        <field name="name">O Dental: preparar recordatorios de citas</field>
        <field name="model_id" ref="odental_core.model_odental_appointment"/>
        <field name="state">code</field>
        <field name="code">model._cron_prepare_appointment_reminders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_odental_expire_slot_offers" model="ir.cron">
        <field name="name">O Dental: vencer ofertas de lista de espera</field>
        <field name="model_id" ref="model_odental_slot_offer"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_offers()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
