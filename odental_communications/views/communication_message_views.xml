<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_communication_message_list" model="ir.ui.view"><field name="name">odental.communication.message.list</field><field name="model">odental.communication.message</field><field name="arch" type="xml"><list decoration-success="state == 'delivered'" decoration-warning="state == 'blocked'" decoration-danger="state == 'failed'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="scheduled_at"/><field name="patient_id"/><field name="message_type"/><field name="channel"/><field name="recipient"/><field name="state"/></list></field></record>
    <record id="view_communication_message_form" model="ir.ui.view"><field name="name">odental.communication.message.form</field><field name="model">odental.communication.message</field><field name="arch" type="xml"><form create="0"><header><button name="action_requeue" type="object" string="Volver a cola" class="btn-primary" invisible="state not in ('blocked', 'failed')"/><button name="action_mark_sent" type="object" string="Registrar envío" class="btn-primary" invisible="state not in ('queued', 'failed')"/><button name="action_mark_delivered" type="object" string="Registrar entrega" class="btn-primary" invisible="state != 'sent'"/><button name="action_mark_failed" type="object" string="Registrar fallo" invisible="state not in ('queued', 'sent')"/><button name="action_cancel" type="object" string="Cancelar" invisible="state not in ('queued', 'blocked', 'failed')"/><field name="state" widget="statusbar" statusbar_visible="queued,sent,delivered"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="organization_id"/><field name="patient_id"/><field name="appointment_id"/><field name="slot_offer_id"/></group><group><field name="message_type"/><field name="channel"/><field name="recipient"/><field name="scheduled_at"/><field name="sent_at"/><field name="delivered_at"/></group></group><field name="body"/><group name="odental_delivery" string="Entrega"><field name="blocking_reason" invisible="not blocking_reason"/><field name="external_reference"/><field name="attempt_count"/><field name="last_error" invisible="not last_error"/></group></sheet><chatter/></form></field></record>
    <record id="action_communication_message" model="ir.actions.act_window"><field name="name">Bandeja de salida</field><field name="res_model">odental.communication.message</field><field name="view_mode">list,form</field><field name="context">{'create': False}</field></record>
</odoo>
