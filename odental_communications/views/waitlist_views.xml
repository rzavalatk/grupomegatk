<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waitlist_entry_list" model="ir.ui.view"><field name="name">odental.waitlist.entry.list</field><field name="model">odental.waitlist.entry</field><field name="arch" type="xml"><list decoration-success="state == 'booked'" decoration-info="state == 'offered'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="patient_id"/><field name="service_id"/><field name="professional_id"/><field name="site_id"/><field name="desired_start_date"/><field name="desired_end_date"/><field name="priority"/><field name="state"/></list></field></record>
    <record id="view_waitlist_entry_form" model="ir.ui.view"><field name="name">odental.waitlist.entry.form</field><field name="model">odental.waitlist.entry</field><field name="arch" type="xml"><form><header><button name="action_cancel" type="object" string="Cancelar solicitud" invisible="state in ('booked', 'cancelled')"/><field name="state" widget="statusbar" statusbar_visible="waiting,offered,booked"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="organization_id"/><field name="patient_id" domain="[('organization_id', '=', organization_id)]"/><field name="service_id" domain="[('organization_id', '=', organization_id)]"/></group><group><field name="professional_id" domain="[('organization_ids', 'in', organization_id)]"/><field name="site_id"/><field name="priority"/><field name="requested_at"/></group></group><group string="Disponibilidad"><field name="desired_start_date"/><field name="desired_end_date"/></group><field name="booked_appointment_id" invisible="not booked_appointment_id"/><field name="notes"/><notebook><page string="Ofertas"><field name="offer_ids" readonly="1"><list><field name="name"/><field name="cancelled_appointment_id"/><field name="offered_at"/><field name="expires_at"/><field name="responded_at"/><field name="state"/></list></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_waitlist_entry" model="ir.actions.act_window"><field name="name">Lista de espera</field><field name="res_model">odental.waitlist.entry</field><field name="view_mode">list,form</field></record>
</odoo>

