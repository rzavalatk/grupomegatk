<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slot_offer_list" model="ir.ui.view"><field name="name">odental.slot.offer.list</field><field name="model">odental.slot.offer</field><field name="arch" type="xml"><list create="0" decoration-success="state == 'accepted'" decoration-warning="state == 'offered'" decoration-muted="state in ('expired', 'cancelled', 'declined')"><field name="name"/><field name="patient_id"/><field name="cancelled_appointment_id"/><field name="offered_at"/><field name="expires_at"/><field name="responded_at"/><field name="state"/></list></field></record>
    <record id="view_slot_offer_form" model="ir.ui.view"><field name="name">odental.slot.offer.form</field><field name="model">odental.slot.offer</field><field name="arch" type="xml"><form create="0"><header><button name="action_accept" type="object" string="Aceptar y reservar" class="btn-primary" invisible="state != 'offered'"/><button name="action_decline" type="object" string="Rechazar" invisible="state != 'offered'"/><button name="action_expire" type="object" string="Marcar vencida" invisible="state != 'offered'"/><button name="action_cancel" type="object" string="Cancelar" invisible="state != 'offered'"/><field name="state" widget="statusbar" statusbar_visible="offered,accepted"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="waitlist_entry_id"/><field name="patient_id"/><field name="cancelled_appointment_id"/></group><group><field name="offered_at"/><field name="expires_at"/><field name="responded_at"/><field name="replacement_appointment_id"/></group></group><field name="message_ids" readonly="1"><list><field name="scheduled_at"/><field name="channel"/><field name="recipient"/><field name="state"/></list></field></sheet><chatter/></form></field></record>
    <record id="action_slot_offer" model="ir.actions.act_window"><field name="name">Ofertas de espacios</field><field name="res_model">odental.slot.offer</field><field name="view_mode">list,form</field><field name="context">{'create': False}</field></record>
</odoo>

