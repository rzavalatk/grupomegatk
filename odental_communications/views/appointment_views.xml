<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_form_communications" model="ir.ui.view"><field name="name">odental.appointment.form.communications</field><field name="model">odental.appointment</field><field name="inherit_id" ref="odental_core.view_odental_appointment_form"/><field name="arch" type="xml"><xpath expr="//header/field[@name='state']" position="before"><button name="action_prepare_reminder" type="object" string="Preparar recordatorio" invisible="state not in ('scheduled', 'confirmed')"/><button name="action_register_patient_confirmation" type="object" string="Paciente confirmó" class="btn-primary" invisible="state not in ('scheduled', 'confirmed') or patient_response == 'confirmed'"/><button name="action_register_patient_cancellation" type="object" string="Paciente canceló" invisible="state not in ('scheduled', 'confirmed')"/></xpath><xpath expr="//sheet" position="inside"><div class="oe_button_box" name="button_box"><button name="action_view_communications" type="object" class="oe_stat_button" icon="fa-comments" invisible="communication_message_count == 0"><field name="communication_message_count" string="Mensajes" widget="statinfo"/></button></div><group string="Confirmación del paciente"><field name="patient_response"/><field name="patient_response_at"/><field name="reminder_due_at"/><field name="replaced_appointment_id" invisible="not replaced_appointment_id"/><field name="replacement_appointment_id" invisible="not replacement_appointment_id"/></group></xpath></field></record>
</odoo>

