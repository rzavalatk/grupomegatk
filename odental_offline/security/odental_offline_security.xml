<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_odental_contingency_batch_member" model="ir.rule">
        <field name="name">O Dental: lotes de contingencia autorizados</field>
        <field name="model_id" ref="model_odental_contingency_batch"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_professional'))]"/>
        <field name="domain_force">['|', ('organization_id.owner_user_id', '=', user.id), ('organization_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_odental_contingency_entry_member" model="ir.rule">
        <field name="name">O Dental: entradas de contingencia autorizadas</field>
        <field name="model_id" ref="model_odental_contingency_entry"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_professional'))]"/>
        <field name="domain_force">['|', ('organization_id.owner_user_id', '=', user.id), ('organization_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_odental_contingency_batch_admin" model="ir.rule">
        <field name="name">O Dental: lotes de contingencia globales</field>
        <field name="model_id" ref="model_odental_contingency_batch"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_odental_contingency_entry_admin" model="ir.rule">
        <field name="name">O Dental: entradas de contingencia globales</field>
        <field name="model_id" ref="model_odental_contingency_entry"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>

