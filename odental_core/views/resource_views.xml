<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_site_list" model="ir.ui.view">
        <field name="name">odental.site.list</field>
        <field name="model">odental.site</field>
        <field name="arch" type="xml">
            <list string="Sedes">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="address"/>
                <field name="shared_with_organization_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_odental_site_form" model="ir.ui.view">
        <field name="name">odental.site.form</field>
        <field name="model">odental.site</field>
        <field name="arch" type="xml">
            <form string="Sede">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Una sede es la dirección física donde funciona uno o varios consultorios.
                    </div>
                    <group>
                        <field name="name" placeholder="Ej.: Sede Tegucigalpa"/>
                        <field name="organization_id"/>
                        <field name="address"/>
                        <field name="active"/>
                    </group>
                    <field name="shared_with_organization_ids" widget="many2many_tags"
                           domain="[('id', '!=', organization_id)]"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odental_site" model="ir.actions.act_window">
        <field name="name">Sedes</field>
        <field name="res_model">odental.site</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_odental_resource_list" model="ir.ui.view">
        <field name="name">odental.resource.list</field>
        <field name="model">odental.resource</field>
        <field name="arch" type="xml">
            <list string="Consultorios, equipos y asistentes">
                <field name="name"/>
                <field name="resource_type"/>
                <field name="site_id"/>
                <field name="organization_id"/>
                <field name="includes_chair" optional="show"/>
                <field name="shared_with_organization_ids" widget="many2many_tags" optional="hide"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_odental_resource_form" model="ir.ui.view">
        <field name="name">odental.resource.form</field>
        <field name="model">odental.resource</field>
        <field name="arch" type="xml">
            <form string="Consultorio, equipo o asistente">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Registre únicamente elementos que necesiten reservarse por horario. Un consultorio con sillón fijo se registra una sola vez.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej.: Consultorio 1, Rayos X MyRay o Asistente María"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="resource_type"/>
                            <field name="organization_id"/>
                            <field name="site_id" domain="[('organization_id', '=', organization_id)]"/>
                            <field name="active"/>
                        </group>
                        <group string="Disponibilidad">
                            <field name="includes_chair" invisible="resource_type != 'room'"/>
                            <field name="user_id" invisible="resource_type != 'assistant'"/>
                            <field name="shared_with_organization_ids" widget="many2many_tags"
                                   domain="[('id', '!=', organization_id)]"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Información adicional para recepción o administración..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odental_room_list" model="ir.ui.view">
        <field name="name">odental.resource.room.list</field>
        <field name="model">odental.resource</field>
        <field name="arch" type="xml">
            <list string="Consultorios">
                <field name="name" string="Consultorio"/>
                <field name="site_id"/>
                <field name="organization_id"/>
                <field name="includes_chair"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_odental_room_form" model="ir.ui.view">
        <field name="name">odental.resource.room.form</field>
        <field name="model">odental.resource</field>
        <field name="arch" type="xml">
            <form string="Consultorio">
                <sheet>
                    <field name="resource_type" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        Registre el espacio físico que se reservará en la agenda. El sillón fijo y el equipo que permanece dentro del consultorio se describen aquí; no se crean como recursos separados.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nombre del consultorio"/>
                        <h1>
                            <field name="name" placeholder="Ej.: Clínica Premium Dra. Jennifer Jovel"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ubicación">
                            <field name="organization_id"/>
                            <field name="site_id" domain="[('organization_id', '=', organization_id)]"/>
                            <field name="active"/>
                        </group>
                        <group string="Disponibilidad">
                            <field name="includes_chair"/>
                            <field name="assignment_mode"/>
                            <field name="fixed_professional_id"
                                   invisible="assignment_mode != 'fixed'"
                                   required="assignment_mode == 'fixed'"
                                   domain="[('organization_ids', 'in', organization_id)]"/>
                            <field name="shared_with_organization_ids" string="Organizaciones autorizadas"
                                   widget="many2many_tags" domain="[('id', '!=', organization_id)]"/>
                        </group>
                    </group>
                    <group string="Características y equipamiento incluido">
                        <field name="notes" nolabel="1"
                               placeholder="Ej.: unidad dental premium, lámpara, mobiliario y equipo que siempre permanece en este consultorio..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odental_equipment_list" model="ir.ui.view">
        <field name="name">odental.resource.equipment.list</field>
        <field name="model">odental.resource</field>
        <field name="arch" type="xml">
            <list string="Equipos compartidos">
                <field name="name" string="Equipo"/>
                <field name="brand" optional="show"/>
                <field name="model" optional="show"/>
                <field name="inventory_code" optional="show"/>
                <field name="site_id"/>
                <field name="organization_id"/>
                <field name="equipment_status" optional="show"/>
                <field name="current_condition" optional="show"/>
                <field name="shared_with_organization_ids" string="Organizaciones autorizadas"
                       widget="many2many_tags" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_odental_equipment_form" model="ir.ui.view">
        <field name="name">odental.resource.equipment.form</field>
        <field name="model">odental.resource</field>
        <field name="arch" type="xml">
            <form string="Equipo compartido">
                <sheet>
                    <field name="resource_type" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        Registre solamente equipos que pueden utilizarse en distintos consultorios y cuya disponibilidad debe controlarse por horario.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nombre del equipo"/>
                        <h1>
                            <field name="name" placeholder="Ej.: Rayos X MyRay o escáner intraoral"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="organization_id"/>
                            <field name="site_id" domain="[('organization_id', '=', organization_id)]"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="inventory_code"/>
                        </group>
                        <group string="Disponibilidad y condición">
                            <field name="equipment_status"/>
                            <field name="current_condition"/>
                            <field name="active"/>
                            <field name="shared_with_organization_ids" string="Organizaciones autorizadas"
                                   widget="many2many_tags" domain="[('id', '!=', organization_id)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción y condición">
                            <group>
                                <field name="image_1920" widget="image" class="oe_avatar"/>
                                <field name="description" placeholder="Características, accesorios incluidos y restricciones de uso..."/>
                            </group>
                            <group string="Condición física actual">
                                <field name="condition_notes" nolabel="1"
                                       placeholder="Ej.: rayadura en el costado derecho o botón de encendido con falla intermitente..."/>
                            </group>
                            <group string="Notas operativas">
                                <field name="notes" nolabel="1"
                                       placeholder="Instrucciones para recepción, traslado o reserva..."/>
                            </group>
                        </page>
                        <page string="Fotografías">
                            <field name="photo_ids">
                                <list editable="bottom">
                                    <field name="taken_at"/>
                                    <field name="name"/>
                                    <field name="image_1920" widget="image"/>
                                    <field name="uploaded_by_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Entregas y devoluciones">
                            <field name="handover_ids">
                                <list editable="bottom" decoration-warning="state == 'open'" decoration-success="state == 'returned'">
                                    <field name="delivered_at"/>
                                    <field name="receiver_partner_id"/>
                                    <field name="delivered_by_id" optional="hide"/>
                                    <field name="checkout_condition"/>
                                    <field name="checkout_notes" optional="hide"/>
                                    <field name="returned_at"/>
                                    <field name="returned_to_id" optional="show"/>
                                    <field name="return_condition"/>
                                    <field name="return_notes" optional="hide"/>
                                    <field name="state" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mantenimientos">
                            <field name="maintenance_ids">
                                <list editable="bottom" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                                    <field name="start_date"/>
                                    <field name="end_date" optional="hide"/>
                                    <field name="maintenance_type"/>
                                    <field name="provider_partner_id"/>
                                    <field name="issue_description"/>
                                    <field name="work_performed" optional="hide"/>
                                    <field name="state"/>
                                    <field name="cost"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odental_resource" model="ir.actions.act_window">
        <field name="name">Consultorios y recursos</field>
        <field name="res_model">odental.resource</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_odental_clinical_space" model="ir.actions.act_window">
        <field name="name">Consultorios</field>
        <field name="res_model">odental.resource</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('resource_type', '=', 'room')]</field>
        <field name="context">{'default_resource_type': 'room', 'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agregue su primer consultorio</p>
            <p>Si el sillón es fijo, marque «Incluye sillón o unidad dental» y no lo registre por separado.</p>
        </field>
    </record>

    <record id="action_odental_clinical_space_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_odental_room_list"/>
        <field name="act_window_id" ref="action_odental_clinical_space"/>
    </record>

    <record id="action_odental_clinical_space_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odental_room_form"/>
        <field name="act_window_id" ref="action_odental_clinical_space"/>
    </record>

    <record id="action_odental_equipment" model="ir.actions.act_window">
        <field name="name">Equipos compartidos</field>
        <field name="res_model">odental.resource</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('resource_type', '=', 'equipment')]</field>
        <field name="context">{'default_resource_type': 'equipment', 'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agregue un equipo que se reserve por horario</p>
            <p>Ejemplos: rayos X, escáner intraoral, microscopio o láser.</p>
        </field>
    </record>

    <record id="action_odental_equipment_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_odental_equipment_list"/>
        <field name="act_window_id" ref="action_odental_equipment"/>
    </record>

    <record id="action_odental_equipment_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odental_equipment_form"/>
        <field name="act_window_id" ref="action_odental_equipment"/>
    </record>

    <record id="action_odental_assistant_resource" model="ir.actions.act_window">
        <field name="name">Asistentes</field>
        <field name="res_model">odental.resource</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('resource_type', '=', 'assistant')]</field>
        <field name="context">{'default_resource_type': 'assistant', 'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agregue asistentes que deban reservarse por horario</p>
            <p>No es necesario registrarlos aquí si su disponibilidad no se controlará en la agenda.</p>
        </field>
    </record>
</odoo>
