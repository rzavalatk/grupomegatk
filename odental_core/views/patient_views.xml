<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_patient_list" model="ir.ui.view"><field name="name">odental.patient.list</field><field name="model">odental.patient</field><field name="arch" type="xml"><list><field name="reference"/><field name="name"/><field name="identification"/><field name="mobile"/><field name="organization_id"/></list></field></record>
    <record id="view_odental_patient_form" model="ir.ui.view"><field name="name">odental.patient.form</field><field name="model">odental.patient</field><field name="arch" type="xml"><form><header><button name="action_new_appointment" type="object" string="Nueva cita" class="btn-primary" icon="fa-calendar-plus-o"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><field name="reference"/></div><group><group><field name="organization_id"/><field name="identification"/><field name="birthdate"/><field name="gender"/></group><group><field name="mobile"/><field name="email"/><field name="partner_id"/><field name="responsible_partner_id"/></group></group><notebook><page string="Notas"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_odental_patient" model="ir.actions.act_window"><field name="name">Pacientes</field><field name="res_model">odental.patient</field><field name="view_mode">list,form</field></record>
</odoo>
