<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_specialty_list" model="ir.ui.view">
        <field name="name">odental.specialty.list</field>
        <field name="model">odental.specialty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_odental_specialty_form" model="ir.ui.view">
        <field name="name">odental.specialty.form</field>
        <field name="model">odental.specialty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_odental_specialty" model="ir.actions.act_window">
        <field name="name">Especialidades</field>
        <field name="res_model">odental.specialty</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
