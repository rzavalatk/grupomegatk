<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_specialty_list" model="ir.ui.view">
        <field name="name">odental.specialty.list</field>
        <field name="model">odental.specialty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_odental_specialty_form" model="ir.ui.view">
        <field name="name">odental.specialty.form</field>
        <field name="model">odental.specialty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_odental_specialty_search" model="ir.ui.view">
        <field name="name">odental.specialty.search</field>
        <field name="model">odental.specialty</field>
        <field name="arch" type="xml">
            <search string="Buscar especialidades y áreas de práctica">
                <field name="name" string="Especialidad o área"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="archived" string="Archivadas" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_odental_specialty" model="ir.actions.act_window">
        <field name="name">Especialidades</field>
        <field name="res_model">odental.specialty</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odental_specialty_search"/>
    </record>
</odoo>
