<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_organization_list" model="ir.ui.view">
        <field name="name">odental.organization.list</field>
        <field name="model">odental.organization</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="code"/><field name="organization_type"/><field name="billing_mode"/><field name="owner_user_id"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>
    <record id="view_odental_organization_form" model="ir.ui.view">
        <field name="name">odental.organization.form</field>
        <field name="model">odental.organization</field>
        <field name="arch" type="xml">
            <form string="Organización O Dental">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group><group><field name="code"/><field name="organization_type"/><field name="billing_mode"/></group><group><field name="owner_user_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group>
                    <notebook><page string="Usuarios"><field name="user_ids" widget="many2many_tags"/></page><page string="Profesionales"><field name="professional_ids" widget="many2many_tags"/></page><page string="Notas"><field name="notes"/></page></notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_odental_organization" model="ir.actions.act_window"><field name="name">Organizaciones</field><field name="res_model">odental.organization</field><field name="view_mode">list,form</field></record>
</odoo>

