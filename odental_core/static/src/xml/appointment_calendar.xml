<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odental_core.AppointmentCalendarEvent">
        <t t-if="!isTimeHidden">
            <span class="d-none d-lg-inline fc-time" t-out="startTime"/>
            <t> </t>
        </t>
        <div class="o_event_title odental_event_title">
            <t t-if="rawRecord.patient_id">
                <div class="odental_event_patient" t-att-title="rawRecord.patient_id[1]" t-out="rawRecord.patient_id[1]"/>
                <div class="odental_event_professional" t-att-title="rawRecord.professional_id &amp;&amp; rawRecord.professional_id[1]" t-out="rawRecord.professional_id &amp;&amp; rawRecord.professional_id[1]"/>
            </t>
            <t t-else="" t-out="title"/>
        </div>
    </t>
</templates>
