<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_odental" model="ir.module.category">
        <field name="name">O Dental</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_odental_user" model="res.groups">
        <field name="name">Usuario clínico</field>
        <field name="category_id" ref="odental_core.module_category_odental"/>
    </record>
    <record id="group_odental_professional" model="res.groups">
        <field name="name">Profesional</field>
        <field name="category_id" ref="odental_core.module_category_odental"/>
        <field name="implied_ids" eval="[(4, ref('odental_core.group_odental_user'))]"/>
    </record>
    <record id="group_odental_manager" model="res.groups">
        <field name="name">Administrador clínico</field>
        <field name="category_id" ref="odental_core.module_category_odental"/>
