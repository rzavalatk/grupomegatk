        <field name="category_id" ref="odental_core.module_category_odental"/>
        <field name="implied_ids" eval="[(4, ref('odental_core.group_odental_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_odental_organization_member" model="ir.rule">
        <field name="name">O Dental: organizaciones autorizadas</field>
        <field name="model_id" ref="model_odental_organization"/>
        <field name="groups" eval="[(4, ref('odental_core.group_odental_user'))]"/>
        <field name="domain_force">['|', ('owner_user_id', '=', user.id), ('user_ids', 'in', [user.id])]</field>
    </record>
