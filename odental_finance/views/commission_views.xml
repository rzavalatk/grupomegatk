<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_commission_rule_list" model="ir.ui.view"><field name="name">odental.commission.rule.list</field><field name="model">odental.commission.rule</field><field name="arch" type="xml"><list><field name="name"/><field name="organization_id"/><field name="company_id" optional="hide"/><field name="professional_id"/><field name="service_id"/><field name="percentage"/><field name="priority"/><field name="active"/></list></field></record>
    <record id="view_odental_commission_rule_form" model="ir.ui.view"><field name="name">odental.commission.rule.form</field><field name="model">odental.commission.rule</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="organization_id"/><field name="company_id"/><field name="professional_id" domain="[('organization_ids', 'in', [organization_id])]"/><field name="service_id" domain="[('organization_id', '=', organization_id)]"/></group><group><field name="percentage"/><field name="priority"/><field name="active"/></group></group><field name="notes"/></sheet></form></field></record>
    <record id="view_odental_commission_settlement_list" model="ir.ui.view"><field name="name">odental.commission.settlement.list</field><field name="model">odental.commission.settlement</field><field name="arch" type="xml"><list decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="organization_id"/><field name="company_id" optional="hide"/><field name="date_from"/><field name="date_to"/><field name="base_amount" sum="Base"/><field name="commission_amount" sum="Comisiones"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_odental_commission_settlement_search" model="ir.ui.view"><field name="name">odental.commission.settlement.search</field><field name="model">odental.commission.settlement</field><field name="arch" type="xml"><search><field name="name"/><field name="organization_id"/><field name="company_id"/><filter name="pending" string="Pendientes" domain="[('state', 'in', ('draft', 'calculated', 'approved'))]"/><filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/><group expand="0" string="Agrupar por"><filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group></search></field></record>
    <record id="view_odental_commission_settlement_form" model="ir.ui.view"><field name="name">odental.commission.settlement.form</field><field name="model">odental.commission.settlement</field><field name="arch" type="xml"><form><header><button name="action_calculate" type="object" string="Calcular desde cobros" class="btn-primary" invisible="state not in ('draft', 'calculated')"/><button name="action_approve" type="object" string="Aprobar liquidación" class="btn-primary" invisible="state != 'calculated'"/><button name="action_mark_paid" type="object" string="Registrar como pagada" class="btn-primary" invisible="state != 'approved'"/><button name="action_cancel" type="object" string="Cancelar" invisible="state not in ('draft', 'calculated')"/><field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved,paid"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="organization_id" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="date_from" readonly="state != 'draft'"/><field name="date_to" readonly="state != 'draft'"/></group><group><field name="base_amount"/><field name="commission_amount"/><field name="currency_id" invisible="1"/><field name="approved_at"/><field name="approved_by_id"/></group></group><field name="line_ids" readonly="1"><list><field name="professional_id"/><field name="collection_id"/><field name="service_id"/><field name="base_amount" sum="Base"/><field name="percentage"/><field name="commission_amount" sum="Comisión"/><field name="currency_id" column_invisible="True"/></list></field><group string="Pago"><field name="payment_reference" readonly="state != 'approved'"/><field name="paid_at"/><field name="paid_by_id"/></group><field name="cancellation_reason" readonly="state == 'cancelled'"/></sheet><chatter/></form></field></record>
    <record id="action_odental_commission_rule" model="ir.actions.act_window"><field name="name">Reglas de comisión</field><field name="res_model">odental.commission.rule</field><field name="view_mode">list,form</field></record>
    <record id="action_odental_commission_settlement" model="ir.actions.act_window"><field name="name">Liquidaciones de comisiones</field><field name="res_model">odental.commission.settlement</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_odental_commission_settlement_search"/></record>
</odoo>
