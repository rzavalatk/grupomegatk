<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_payment_agreement_list" model="ir.ui.view">
        <field name="name">odental.payment.agreement.list</field><field name="model">odental.payment.agreement</field>
        <field name="arch" type="xml"><list decoration-success="state == 'completed'" decoration-danger="state == 'defaulted'" decoration-muted="state == 'cancelled'">
            <field name="name"/><field name="patient_id"/><field name="organization_id"/><field name="company_id" optional="hide"/><field name="principal_amount" sum="Principal"/><field name="scheduled_amount" sum="Programado"/><field name="amount_paid" sum="Pagado"/><field name="balance_amount" sum="Saldo"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/>
        </list></field>
    </record>
    <record id="view_odental_payment_agreement_search" model="ir.ui.view">
        <field name="name">odental.payment.agreement.search</field><field name="model">odental.payment.agreement</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="organization_id"/><filter name="active" string="Activos" domain="[('state', 'in', ('approved', 'active', 'defaulted'))]"/><filter name="defaulted" string="En mora" domain="[('state', '=', 'defaulted')]"/><group expand="0" string="Agrupar por"><filter name="group_patient" string="Paciente" context="{'group_by': 'patient_id'}"/><filter name="group_state" string="Estado" context="{'group_by': 'state'}"/></group></search></field>
    </record>
    <record id="view_odental_payment_installment_form" model="ir.ui.view">
        <field name="name">odental.payment.installment.form</field><field name="model">odental.payment.installment</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="agreement_id"/><field name="sequence"/><field name="due_date"/></group><group><field name="amount_due"/><field name="amount_paid"/><field name="balance_amount"/><field name="currency_id" invisible="1"/><field name="state" widget="badge"/></group></group><field name="allocation_ids"><list editable="bottom"><field name="collection_id"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="applied_at"/><field name="applied_by_id"/><field name="notes"/></list></field></sheet></form></field>
    </record>
    <record id="view_odental_payment_agreement_form" model="ir.ui.view">
        <field name="name">odental.payment.agreement.form</field><field name="model">odental.payment.agreement</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_generate_schedule" type="object" string="Generar cuotas" class="btn-primary" invisible="state != 'draft'"/><button name="action_propose" type="object" string="Presentar convenio" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" groups="odental_core.group_odental_manager" invisible="state != 'proposed'"/><button name="action_activate" type="object" string="Activar" class="btn-primary" invisible="state != 'approved'"/><button name="action_refresh_status" type="object" string="Actualizar estado" invisible="state not in ('active', 'defaulted')"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('completed', 'cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,proposed,approved,active,completed"/>
        </header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
            <group><group><field name="patient_id" readonly="state != 'draft'"/><field name="organization_id"/><field name="company_id" readonly="state != 'draft'"/><field name="invoice_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="invoice_balance"/></group><group><field name="down_payment" readonly="state != 'draft'"/><field name="down_payment_collection_id" readonly="state not in ('draft', 'proposed', 'approved')"/><field name="finance_charge_percent" readonly="state != 'draft'"/><field name="installment_count" readonly="state != 'draft'"/><field name="frequency" readonly="state != 'draft'"/><field name="first_due_date" readonly="state != 'draft'"/><field name="currency_id" invisible="1"/></group></group>
            <group string="Resumen"><field name="principal_amount"/><field name="financed_amount"/><field name="finance_charge_amount"/><field name="scheduled_amount"/><field name="amount_paid"/><field name="balance_amount"/></group>
            <notebook><page string="Cuotas"><field name="line_ids" readonly="1"><list decoration-success="state == 'paid'" decoration-danger="state == 'overdue'"><field name="sequence"/><field name="due_date"/><field name="amount_due" sum="Programado"/><field name="amount_paid" sum="Pagado"/><field name="balance_amount" sum="Saldo"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></page>
            <page string="Aceptación"><group><field name="signer_name" readonly="state not in ('draft', 'proposed')"/><field name="acceptance_reference" readonly="state not in ('draft', 'proposed')"/><field name="approved_at"/><field name="approved_by_id"/></group></page><page string="Cancelación"><field name="cancellation_reason" readonly="state == 'cancelled'"/></page></notebook>
        </sheet><chatter/></form></field>
    </record>
    <record id="view_odental_installment_allocation_list" model="ir.ui.view"><field name="name">odental.installment.allocation.list</field><field name="model">odental.installment.allocation</field><field name="arch" type="xml"><list><field name="agreement_id"/><field name="installment_id"/><field name="collection_id"/><field name="amount" sum="Aplicado"/><field name="currency_id" column_invisible="True"/><field name="applied_at"/><field name="applied_by_id"/></list></field></record>
    <record id="view_odental_installment_allocation_form" model="ir.ui.view"><field name="name">odental.installment.allocation.form</field><field name="model">odental.installment.allocation</field><field name="arch" type="xml"><form><sheet><group><field name="installment_id"/><field name="agreement_id"/><field name="company_id"/><field name="collection_id"/><field name="amount"/><field name="currency_id" invisible="1"/><field name="applied_at"/><field name="applied_by_id"/><field name="notes"/></group></sheet></form></field></record>
    <record id="action_odental_payment_agreement" model="ir.actions.act_window"><field name="name">Convenios de pago</field><field name="res_model">odental.payment.agreement</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_odental_payment_agreement_search"/></record>
    <record id="action_odental_installment_allocation" model="ir.actions.act_window"><field name="name">Aplicación de abonos</field><field name="res_model">odental.installment.allocation</field><field name="view_mode">list,form</field></record>
</odoo>
