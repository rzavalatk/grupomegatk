<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_odental_payment_agreement" model="ir.sequence">
        <field name="name">Convenio de pago O Dental</field>
        <field name="code">odental.payment.agreement</field>
        <field name="prefix">CONV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_odental_commission_settlement" model="ir.sequence">
        <field name="name">Liquidación de comisiones O Dental</field>
        <field name="code">odental.commission.settlement</field>
        <field name="prefix">COM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
