<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_case_list" model="ir.ui.view"><field name="name">odental.lab.case.list</field><field name="model">odental.lab.case</field><field name="arch" type="xml"><list decoration-success="state == 'accepted'" decoration-danger="state == 'rework'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="patient_id"/><field name="laboratory_id"/><field name="work_type"/><field name="tooth_id"/><field name="responsible_professional_id"/><field name="sent_date"/><field name="expected_return_date"/><field name="rework_count"/><field name="state"/></list></field></record>
    <record id="view_lab_case_form" model="ir.ui.view"><field name="name">odental.lab.case.form</field><field name="model">odental.lab.case</field><field name="arch" type="xml"><form><header><button name="action_create_purchase_order" type="object" string="Crear orden de compra" invisible="purchase_order_id or state in ('accepted', 'cancelled')"/><button name="action_send" type="object" string="Enviar al laboratorio" class="btn-primary" invisible="state not in ('draft', 'rework')"/><button name="action_receive" type="object" string="Registrar recepción" class="btn-primary" invisible="state != 'sent'"/><button name="action_fitting" type="object" string="Prueba clínica" invisible="state != 'received'"/><button name="action_accept" type="object" string="Aceptar trabajo" class="btn-primary" invisible="state not in ('received', 'fitting')"/><button name="action_rework" type="object" string="Solicitar retrabajo" invisible="state not in ('received', 'fitting')"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('accepted', 'cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,sent,received,fitting,rework,accepted"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_purchase_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_order_id"><field name="purchase_order_id" string="Compra" widget="statinfo"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="clinical_record_id"/><field name="patient_id"/><field name="treatment_line_id" domain="[('plan_id.clinical_record_id', '=', clinical_record_id)]"/><field name="tooth_id"/><field name="responsible_professional_id" domain="[('organization_ids', 'in', organization_id)]"/></group><group><field name="organization_id"/><field name="laboratory_id" domain="[('organization_id', '=', organization_id)]"/><field name="work_type"/><field name="material"/><field name="shade"/></group></group><group string="Fechas"><field name="requested_date"/><field name="sent_date"/><field name="expected_return_date"/><field name="received_date"/><field name="accepted_date"/></group><field name="instructions"/><group string="Costos"><field name="estimated_cost"/><field name="actual_cost"/><field name="currency_id" invisible="1"/><field name="purchase_product_id"/><field name="purchase_order_id" readonly="1"/></group><group string="Incidencias"><field name="rework_count"/><field name="rework_reason" invisible="state not in ('received', 'fitting', 'rework')"/><field name="cancellation_reason" invisible="state in ('accepted', 'cancelled')"/></group><notebook><page string="Trazabilidad"><field name="event_ids" readonly="1"><list><field name="occurred_at"/><field name="event_type"/><field name="user_id"/><field name="note"/></list></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_lab_case" model="ir.actions.act_window"><field name="name">Casos de laboratorio</field><field name="res_model">odental.lab.case</field><field name="view_mode">list,form</field></record>
</odoo>

