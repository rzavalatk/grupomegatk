<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_clinical_collection_list" model="ir.ui.view">
        <field name="name">odental.clinical.collection.list</field>
        <field name="model">odental.clinical.collection</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'registered'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="cash_session_id"/>
                <field name="patient_id"/>
                <field name="invoice_id"/>
                <field name="payment_channel"/>
                <field name="journal_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="received_at"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_odental_clinical_collection_search" model="ir.ui.view">
        <field name="name">odental.clinical.collection.search</field>
        <field name="model">odental.clinical.collection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="invoice_id"/>
                <field name="cash_session_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'draft')]"/>
                <filter name="registered" string="Registrados" domain="[('state', '=', 'registered')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_session" string="Caja" context="{'group_by': 'cash_session_id'}"/>
                    <filter name="group_channel" string="Canal" context="{'group_by': 'payment_channel'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_odental_clinical_collection_form" model="ir.ui.view">
        <field name="name">odental.clinical.collection.form</field>
        <field name="model">odental.clinical.collection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_register_payment" type="object" string="Registrar pago en Odoo" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,registered,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="cash_session_id" readonly="state != 'draft'" domain="[('state', '=', 'open')]"/>
                            <field name="organization_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="patient_id" readonly="state != 'draft'" domain="[('organization_id', '=', organization_id)]"/>
                            <field name="invoice_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payment_channel" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="affects_cash" readonly="state != 'draft'"/>
                            <field name="memo" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="state == 'draft'">
                        <field name="account_payment_id"/>
                        <field name="received_at"/>
                        <field name="received_by_id"/>
                    </group>
                    <field name="cancellation_reason" invisible="state == 'registered'" readonly="state == 'cancelled'" placeholder="Obligatorio antes de cancelar..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_odental_clinical_collection" model="ir.actions.act_window">
        <field name="name">Cobros clínicos</field>
        <field name="res_model">odental.clinical.collection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odental_clinical_collection_search"/>
    </record>
</odoo>
