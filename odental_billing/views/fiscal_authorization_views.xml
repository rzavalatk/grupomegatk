<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_fiscal_authorization_list" model="ir.ui.view">
        <field name="name">odental.fiscal.authorization.list</field>
        <field name="model">odental.fiscal.authorization</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-warning="remaining_count &lt;= 50 and state == 'active'" decoration-danger="state in ('expired', 'exhausted', 'revoked')">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="site_id"/>
                <field name="document_type"/>
                <field name="cai" optional="hide"/>
                <field name="range_display"/>
                <field name="next_number"/>
                <field name="remaining_count"/>
                <field name="date_limit"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_odental_fiscal_authorization_search" model="ir.ui.view">
        <field name="name">odental.fiscal.authorization.search</field>
        <field name="model">odental.fiscal.authorization</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cai"/>
                <field name="organization_id"/>
                <field name="company_id"/>
                <field name="site_id"/>
                <filter name="active" string="Activas" domain="[('state', '=', 'active')]"/>
                <filter name="attention" string="Requieren atención" domain="[('state', 'in', ('expired', 'exhausted', 'revoked'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"/>
                    <filter name="group_site" string="Sede" context="{'group_by': 'site_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_odental_fiscal_authorization_form" model="ir.ui.view">
        <field name="name">odental.fiscal.authorization.form</field>
        <field name="model">odental.fiscal.authorization</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activar autorización" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_refresh_status" type="object" string="Verificar vigencia" invisible="state != 'active'"/>
                    <button name="action_revoke" type="object" string="Revocar" invisible="state not in ('active', 'expired', 'exhausted')" confirm="La autorización dejará de estar disponible. ¿Desea continuar?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,exhausted,expired,revoked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="organization_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="site_id" readonly="state != 'draft'" domain="['|', ('organization_id', '=', organization_id), ('shared_with_organization_ids', 'in', [organization_id])]"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="document_type" readonly="state != 'draft'"/>
                            <field name="establishment_code" readonly="state != 'draft'"/>
                            <field name="emission_point_code" readonly="state != 'draft'"/>
                            <field name="cai" password="True" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Rango y vigencia">
                        <group>
                            <field name="range_start" readonly="state != 'draft'"/>
                            <field name="range_end" readonly="state != 'draft'"/>
                            <field name="next_number" readonly="state != 'draft'"/>
                            <field name="range_display" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_limit" readonly="state != 'draft'"/>
                            <field name="remaining_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        El CAI, los códigos, el rango y la vigencia deben copiarse de la autorización oficial de SAR. O Dental no genera estos valores.
                    </div>
                    <field name="notes" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_odental_fiscal_authorization" model="ir.actions.act_window">
        <field name="name">Autorizaciones SAR</field>
        <field name="res_model">odental.fiscal.authorization</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odental_fiscal_authorization_search"/>
    </record>
</odoo>
