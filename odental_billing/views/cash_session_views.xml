<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_cash_session_list" model="ir.ui.view">
        <field name="name">odental.cash.session.list</field>
        <field name="model">odental.cash.session</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'open'" decoration-danger="state == 'closed' and difference_amount != 0">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="site_id"/>
                <field name="cashier_id"/>
                <field name="opened_at"/>
                <field name="opening_amount" sum="Apertura"/>
                <field name="collected_amount" sum="Cobrado"/>
                <field name="expected_closing_amount" sum="Esperado"/>
                <field name="actual_closing_amount" sum="Contado"/>
                <field name="difference_amount" sum="Diferencia"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_odental_cash_session_search" model="ir.ui.view">
        <field name="name">odental.cash.session.search</field>
        <field name="model">odental.cash.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="organization_id"/>
                <field name="site_id"/>
                <field name="cashier_id"/>
                <filter name="open" string="Abiertas" domain="[('state', '=', 'open')]"/>
                <filter name="with_difference" string="Con diferencia" domain="[('state', '=', 'closed'), ('difference_amount', '!=', 0)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_site" string="Sede" context="{'group_by': 'site_id'}"/>
                    <filter name="group_cashier" string="Cajero" context="{'group_by': 'cashier_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_odental_cash_session_form" model="ir.ui.view">
        <field name="name">odental.cash.session.form</field>
        <field name="model">odental.cash.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Abrir caja" class="btn-primary" invisible="state != 'draft'" groups="odental_core.group_odental_manager"/>
                    <button name="action_close" type="object" string="Cerrar y arquear" class="btn-primary" invisible="state != 'open'" groups="odental_core.group_odental_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="organization_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="site_id" readonly="state != 'draft'" domain="['|', ('organization_id', '=', organization_id), ('shared_with_organization_ids', 'in', [organization_id])]"/>
                            <field name="cashier_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="opened_at"/>
                            <field name="opened_by_id"/>
                            <field name="closed_at"/>
                            <field name="closed_by_id"/>
                        </group>
                    </group>
                    <group string="Arqueo">
                        <group>
                            <field name="opening_amount" readonly="state != 'draft'"/>
                            <field name="cash_collected_amount"/>
                            <field name="expected_closing_amount"/>
                        </group>
                        <group>
                            <field name="collected_amount"/>
                            <field name="actual_closing_amount" readonly="state != 'open'"/>
                            <field name="difference_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cobros">
                            <field name="collection_ids" readonly="state == 'closed'">
                                <list>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="invoice_id"/>
                                    <field name="payment_channel"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cierre">
                            <field name="closing_notes" readonly="state == 'closed'" placeholder="Explique cualquier diferencia o incidencia del cierre..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_odental_cash_session" model="ir.actions.act_window">
        <field name="name">Sesiones de caja</field>
        <field name="res_model">odental.cash.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odental_cash_session_search"/>
    </record>
</odoo>
