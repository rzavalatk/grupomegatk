<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_commercial_assignment_lock" model="ir.ui.view">
        <field name="name">res.partner.form.commercial.assignment.lock</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="commercial_assignment_locked" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly" add="commercial_assignment_locked" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
