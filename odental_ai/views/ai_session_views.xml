<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_ai_session_list" model="ir.ui.view">
        <field name="name">odental.ai.session.list</field>
        <field name="model">odental.ai.session</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'analyzed'" decoration-warning="state == 'confirmed'" decoration-success="state == 'executed'" decoration-muted="state in ('undone', 'cancelled')">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="patient_id"/>
                <field name="professional_id"/>
                <field name="input_source"/>
                <field name="action_count"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_odental_ai_session_search" model="ir.ui.view">
        <field name="name">odental.ai.session.search</field>
        <field name="model">odental.ai.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="professional_id"/>
                <field name="organization_id"/>
                <filter name="pending" string="Por confirmar" domain="[('state', 'in', ('analyzed', 'confirmed'))]"/>
                <filter name="executed" string="Ejecutadas" domain="[('state', '=', 'executed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_organization" string="Organización" context="{'group_by': 'organization_id'}"/>
                    <filter name="group_professional" string="Profesional" context="{'group_by': 'professional_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_odental_ai_session_form" model="ir.ui.view">
        <field name="name">odental.ai.session.form</field>
        <field name="model">odental.ai.session</field>
        <field name="arch" type="xml">
            <form string="Asistente IA">
                <header>
                    <button name="action_analyze" type="object" string="Analizar instrucción" class="btn-primary" invisible="state != 'captured'"/>
                    <button name="action_confirm" type="object" string="Confirmar propuesta" class="btn-primary" invisible="state != 'analyzed'"/>
                    <button name="action_execute" type="object" string="Ejecutar confirmada" class="btn-primary" invisible="state != 'confirmed'" confirm="Se ejecutarán solamente las acciones mostradas. ¿Desea continuar?"/>
                    <button name="action_undo" type="object" string="Deshacer" invisible="state != 'executed' or reversible_action_count != action_count" confirm="Solo se deshará si los borradores siguen sin cambios. ¿Desea continuar?"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state not in ('captured', 'analyzed', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="captured,analyzed,confirmed,executed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_audit" type="object" class="oe_stat_button" icon="fa-shield">
                            <field name="audit_count" widget="statinfo" string="Auditoría"/>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Contexto clínico">
                            <field name="organization_id" readonly="state != 'captured'"/>
                            <field name="patient_id" domain="[('organization_id', '=', organization_id)]" readonly="state != 'captured'"/>
                            <field name="professional_id" domain="[('organization_ids', 'in', [organization_id])]" readonly="state != 'captured'"/>
                            <field name="appointment_id" domain="[('organization_id', '=', organization_id), ('patient_id', '=', patient_id)]" readonly="state != 'captured'"/>
                            <field name="odontogram_id" domain="[('organization_id', '=', organization_id), ('patient_id', '=', patient_id), ('state', '=', 'draft')]" readonly="state != 'captured'"/>
                        </group>
                        <group string="Contexto para agendar">
                            <field name="service_id" domain="[('organization_id', '=', organization_id)]" readonly="state != 'captured'"/>
                            <field name="site_id" readonly="state != 'captured'"/>
                            <field name="resource_ids" widget="many2many_tags" domain="[('site_id', '=', site_id)]" readonly="state != 'captured'"/>
                            <field name="input_source" readonly="state != 'captured'"/>
                            <field name="language_code" readonly="state != 'captured'"/>
                            <field name="engine"/>
                        </group>
                    </group>
                    <group string="Instrucción">
                        <field name="command_text" widget="odental_voice_text" nolabel="1" readonly="state != 'captured'" placeholder="Ejemplo:&#10;Motivo: dolor en pieza 26&#10;Diagnóstico: pulpitis irreversible&#10;Pieza 26 caries oclusal"/>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not warning_text">
                        <strong>La propuesta no puede confirmarse:</strong>
                        <field name="warning_text" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Propuesta">
                            <field name="action_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="action_type"/>
                                    <field name="preview"/>
                                    <field name="detail_text"/>
                                    <field name="undo_supported"/>
                                    <field name="status" widget="badge"/>
                                    <field name="target_model" optional="hide"/>
                                    <field name="target_res_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Control y huellas">
                            <group>
                                <group><field name="input_hash"/><field name="proposal_hash"/><field name="execution_hash"/></group>
                                <group><field name="confirmed_at"/><field name="confirmed_by_id"/><field name="executed_at"/><field name="executed_by_id"/><field name="undone_at"/><field name="undone_by_id"/></group>
                            </group>
                        </page>
                        <page string="Auditoría">
                            <field name="audit_ids" readonly="1">
                                <list create="0" delete="0" edit="0"><field name="occurred_at"/><field name="event_type"/><field name="user_id"/><field name="summary"/><field name="content_hash" optional="hide"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_odental_ai_session" model="ir.actions.act_window">
        <field name="name">Asistente IA</field>
        <field name="res_model">odental.ai.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_odental_ai_session_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
