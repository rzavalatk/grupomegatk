<odoo>
    <record id="company_form_workspace" model="ir.ui.view">
        <field name="name">res.company.form.odental.workspace</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Espacio O Dental" groups="base.group_system">
                    <group>
                        <field name="odental_workspace_enabled"/>
                        <field name="odental_workspace_menu_ids" widget="many2many_tags" options="{'no_create': True}" invisible="not odental_workspace_enabled"/>
                    </group>
                    <p>La selección simplifica las aplicaciones visibles de esta compañía. Los permisos de los usuarios siguen controlando el acceso a datos y acciones.</p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
