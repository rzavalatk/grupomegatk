<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_professional_todoist_form" model="ir.ui.view">
        <field name="name">odental.professional.todoist.form</field>
        <field name="model">odental.professional</field>
        <field name="inherit_id" ref="odental_core.view_odental_professional_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_my_todoist_settings" type="object"
                            string="Configurar mi Todoist" class="btn-secondary"
                            groups="odental_core.group_odental_professional"
                            invisible="user_id != uid"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
